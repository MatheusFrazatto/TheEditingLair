---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PluginTable from '../../components/PluginTable.astro';
import Icon from '../../components/Icon.astro';
import { getPlugins, getPosts } from '../../lib/content';
import { categoryLabel, isoDate, readingMinutes } from '../../lib/format';
import { withBase } from '../../lib/url';
import { noteSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // posts are newest first: "newer" is the previous entry
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  newer?: CollectionEntry<'posts'>;
  older?: CollectionEntry<'posts'>;
}

const { post, newer, older } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const related = (await getPlugins()).filter((p) => d.relatedPlugins.includes(p.id));
---
<Base title={d.title} description={d.description} current="notes" jsonLd={noteSchema(post, Astro.site!)}>
  <div class="page">
    <div class="sheet-wrap main-sheet">
      <article class="sheet doc">
        <nav class="crumbs legend" aria-label="Breadcrumb">
          <a href={withBase('notes/')}><Icon name="back" /><span class="ln">All notes</span></a>
        </nav>
        <header class="doc__head">
          <h1 class="display doc__title">{d.title}</h1>
          <p class="doc__meta legend">
            <time class="n" datetime={d.published.toISOString()}>{isoDate(d.published)}</time>
            <span>{categoryLabel[d.category]}</span>
            <span><span class="n">{readingMinutes(post.body)}</span> min read</span>
            {d.updated && <span>Updated <span class="n">{isoDate(d.updated)}</span></span>}
            {d.draft && <span class="draft-tag">Draft</span>}
          </p>
          <p class="doc__lede">{d.description}</p>
        </header>

        {d.cover && (
          <figure class="doc__figure">
            <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 960, 1280]} sizes="(max-width: 860px) 100vw, 860px" />
          </figure>
        )}

        <div class="prose">
          <Content />
        </div>

        {related.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <h2 class="related__title" id="related-heading">Plugins in this note</h2>
            <PluginTable plugins={related} headingId="related-heading" />
          </section>
        )}
      </article>
    </div>

    {(newer || older) && (
      <nav class="pager" aria-label="More notes">
        {older ? (
          <a class="pager__link" href={withBase(`notes/${older.id}/`)}>
            <span class="legend"><Icon name="back" />Older</span>
            <span class="pager__title ln ln--quiet">{older.data.title}</span>
          </a>
        ) : <span />}
        {newer && (
          <a class="pager__link pager__link--next" href={withBase(`notes/${newer.id}/`)}>
            <span class="legend">Newer<Icon name="arrow" /></span>
            <span class="pager__title ln ln--quiet">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</Base>

<style>
  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 40px var(--gutter) 0;
  }
  .main-sheet {
    animation: settle 800ms var(--ease-settle) both;
  }
  .doc {
    padding: clamp(26px, 4vw, 52px) clamp(20px, 5vw, 64px) clamp(36px, 5vw, 64px);
  }
  .crumbs {
    display: flex;
    gap: 10px;
    margin-bottom: 26px;
    font-size: 0.8125rem;
    color: var(--z4);
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--z2);
  }
  .crumbs svg {
    width: 13px;
    height: 13px;
  }
  .doc__title {
    max-width: 16ch;
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    color: var(--act);
  }
  .doc__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    margin: 18px 0 0;
    font-size: 0.8125rem;
    color: var(--z4);
  }
  .doc__meta .n {
    font-size: 0.875rem;
    color: var(--z1);
  }
  .doc__lede {
    max-width: 52ch;
    margin: 22px 0 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--z0);
    font-size: clamp(1.1875rem, 1.7vw, 1.375rem);
    line-height: 1.5;
    color: var(--z2);
  }
  .doc__figure {
    margin: 0 0 40px;
  }
  .related {
    margin-top: 56px;
  }
  .related__title {
    margin: 0 0 18px;
    font: 750 1.375rem/1.15 var(--f-legend);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--z0);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
  }
  .pager__link {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 22px;
    background: rgb(189 189 189 / 0.1);
    border: 1px solid rgb(242 242 242 / 0.18);
    text-decoration: none;
    transition: background-color 240ms var(--ease-out);
  }
  .pager__link:hover {
    background: rgb(189 189 189 / 0.18);
  }
  .pager__link--next {
    text-align: right;
    align-items: flex-end;
  }
  .pager .legend {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--z8);
  }
  .pager svg {
    width: 14px;
    height: 14px;
  }
  .pager__title {
    font: 650 1.25rem/1.25 var(--f-legend);
    letter-spacing: 0.01em;
    color: var(--z10);
  }
  @media (max-width: 760px) {
    .page {
      padding-top: 20px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
