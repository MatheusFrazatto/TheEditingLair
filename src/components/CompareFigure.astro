---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  effect: ImageMetadata;
  original: ImageMetadata;
  alt?: string;
}

const { title, effect, original, alt } = Astro.props;
const widths = [640, 960, 1280, 1920];
const sizes = '(max-width: 860px) 100vw, 860px';
---
<figure class="compare" data-compare style={`--pos: 50%; --ratio: ${original.width / original.height}`}>
  <div class="compare__frame" data-frame>
    <Image class="compare__img" src={original} alt={`The same frame without ${title}.`} widths={widths} sizes={sizes} />
    <div class="compare__after">
      <Image class="compare__img" src={effect} alt={alt ?? ''} widths={widths} sizes={sizes} />
    </div>
    <span class="compare__tag compare__tag--before" aria-hidden="true">Original</span>
    <span class="compare__tag compare__tag--after" aria-hidden="true">{title}</span>
    <div
      class="compare__handle"
      data-handle
      role="slider"
      tabindex="0"
      aria-label={`Compare the original frame with ${title}`}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
      aria-valuetext="50% original"
    >
      <span class="compare__grip">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M9 7 4 12l5 5M15 7l5 5-5 5" />
        </svg>
      </span>
    </div>
    <button class="compare__full" type="button" data-full aria-label="View full screen" aria-pressed="false">
      <svg class="compare__icon-open" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" />
      </svg>
      <svg class="compare__icon-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5" />
      </svg>
    </button>
  </div>
  <figcaption class="compare__cap">Drag the line to compare the original frame with {title}.</figcaption>
</figure>

<style>
  .compare {
    margin: 0 0 40px;
  }
  .compare__frame {
    position: relative;
    overflow: hidden;
    background: var(--z0);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .compare__img {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  /* the effect develops over the original from the divider rightwards */
  .compare__after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos));
  }
  .compare__after .compare__img {
    height: 100%;
    object-fit: cover;
  }

  .compare__tag {
    position: absolute;
    top: 14px;
    padding: 6px 10px 5px;
    background: var(--z0);
    color: var(--z10);
    font: 600 0.75rem/1 var(--f-legend);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    pointer-events: none;
    transition: opacity 240ms var(--ease-out);
  }
  .compare__tag--before {
    left: 14px;
  }
  .compare__tag--after {
    right: 14px;
  }
  /* a tag steps aside when the divider runs over it */
  [data-compare][data-hide='before'] .compare__tag--before,
  [data-compare][data-hide='after'] .compare__tag--after {
    opacity: 0;
  }

  .compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 44px;
    margin-left: -22px;
    display: grid;
    place-items: center;
    outline: none;
  }
  .compare__handle::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 21px;
    width: 2px;
    background: var(--z10);
    box-shadow: 0 0 0 1px rgb(13 13 13 / 0.35);
  }
  .compare__grip {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--z0);
    border: 1px solid var(--z10);
    box-shadow: 0 6px 14px rgb(13 13 13 / 0.5), 0 1px 2px rgb(13 13 13 / 0.4);
    transition: transform 320ms var(--ease-settle), background-color 200ms var(--ease-out);
  }
  .compare__grip svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--z10);
    stroke-width: 1.75;
    stroke-linecap: square;
  }
  .compare__frame:hover .compare__grip,
  [data-compare].is-held .compare__grip {
    transform: scale(1.08);
  }
  [data-compare].is-held .compare__grip {
    background: var(--z1);
  }
  /* keyboard focus lands on the grip, in filtration */
  .compare__handle:focus-visible .compare__grip {
    outline: 2px solid var(--filter);
    outline-offset: 3px;
  }

  /* full screen: the frame fills the screen at its own aspect, on print black */
  .compare__full {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: var(--z0);
    border: 1px solid rgb(242 242 242 / 0.45);
    color: var(--z10);
    cursor: pointer;
    transition: border-color 200ms var(--ease-out), background-color 200ms var(--ease-out);
  }
  .compare__full:hover {
    border-color: var(--z10);
    background: var(--z1);
  }
  .compare__full svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: square;
  }
  .compare__icon-close,
  [data-compare].is-full .compare__icon-open {
    display: none;
  }
  [data-compare].is-full .compare__icon-close {
    display: block;
  }
  [data-compare].is-full {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    margin: 0;
    background: var(--z0);
  }
  [data-compare].is-full .compare__frame {
    width: min(100vw, calc(100vh * var(--ratio)));
    width: min(100vw, calc(100dvh * var(--ratio)));
  }
  [data-compare].is-full .compare__cap {
    display: none;
  }
  :global(html.compare-open) {
    overflow: hidden;
  }

  .compare__cap {
    margin-top: 12px;
    font: 500 0.9375rem/1.3 var(--f-legend);
    letter-spacing: 0.01em;
    color: var(--z4);
  }

  @media (max-width: 760px) {
    .compare__tag {
      top: 10px;
    }
    .compare__tag--before {
      left: 10px;
    }
    .compare__tag--after {
      right: 10px;
    }
  }
</style>

<script>
  import { animate } from 'animejs';

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const KEY_STEP = 5;
  const PAGE_STEP = 10;
  const TAG_ZONE = 18; // % from an edge where the divider would cover a tag

  function setupCompare(root: HTMLElement) {
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const handle = root.querySelector<HTMLElement>('[data-handle]')!;
    const state = { pos: 50 };
    let touched = false;
    let hint: ReturnType<typeof animate> | null = null;

    function apply(pos: number) {
      state.pos = Math.min(100, Math.max(0, pos));
      const rounded = Math.round(state.pos);
      root.style.setProperty('--pos', `${state.pos}%`);
      handle.setAttribute('aria-valuenow', String(rounded));
      handle.setAttribute('aria-valuetext', `${rounded}% original`);
      root.dataset.hide = state.pos < TAG_ZONE ? 'before' : state.pos > 100 - TAG_ZONE ? 'after' : '';
    }

    // the first touch of the user ends any hint in progress
    function take() {
      touched = true;
      hint?.cancel();
      hint = null;
    }

    const fromPointer = (e: PointerEvent) => {
      const box = frame.getBoundingClientRect();
      apply(((e.clientX - box.left) / box.width) * 100);
    };

    frame.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || (e.target as HTMLElement).closest('[data-full]')) return;
      take();
      frame.setPointerCapture(e.pointerId);
      root.classList.add('is-held');
      fromPointer(e);
    });
    frame.addEventListener('pointermove', (e) => {
      if (frame.hasPointerCapture(e.pointerId)) fromPointer(e);
    });
    const release = (e: PointerEvent) => {
      if (frame.hasPointerCapture(e.pointerId)) frame.releasePointerCapture(e.pointerId);
      root.classList.remove('is-held');
    };
    frame.addEventListener('pointerup', release);
    frame.addEventListener('pointercancel', release);

    handle.addEventListener('keydown', (e) => {
      const moves: Record<string, number> = {
        ArrowLeft: state.pos - KEY_STEP,
        ArrowDown: state.pos - KEY_STEP,
        ArrowRight: state.pos + KEY_STEP,
        ArrowUp: state.pos + KEY_STEP,
        PageDown: state.pos - PAGE_STEP,
        PageUp: state.pos + PAGE_STEP,
        Home: 0,
        End: 100,
      };
      if (!(e.key in moves)) return;
      e.preventDefault();
      take();
      apply(moves[e.key]);
    });

    // ── full screen: the real Fullscreen API where it exists, a fixed layer
    // over the page where it does not (iPhone Safari) ──
    const full = root.querySelector<HTMLButtonElement>('[data-full]')!;
    const isNative = () => document.fullscreenElement === root;
    // The sheet keeps a transform from its settle animation, which would trap
    // a fixed layer inside it, so the fallback lifts the figure to <body>.
    let spot: Comment | null = null;

    function setFull(on: boolean) {
      root.classList.toggle('is-full', on);
      document.documentElement.classList.toggle('compare-open', on);
      full.setAttribute('aria-pressed', String(on));
      full.setAttribute('aria-label', on ? 'Exit full screen' : 'View full screen');
      if (!on && spot) {
        spot.replaceWith(root);
        spot = null;
        full.focus({ preventScroll: true });
      }
    }

    function liftToBody() {
      spot = document.createComment('compare');
      root.replaceWith(spot);
      document.body.appendChild(root);
      full.focus({ preventScroll: true });
    }

    full.addEventListener('click', async () => {
      if (root.classList.contains('is-full')) {
        if (isNative()) await document.exitFullscreen();
        setFull(false);
        return;
      }
      setFull(true);
      try {
        if (!root.requestFullscreen) throw new Error('no fullscreen');
        await root.requestFullscreen();
      } catch {
        liftToBody();
      }
    });
    // leaving native full screen with Esc or the browser UI
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement && root.classList.contains('is-full')) setFull(false);
    });
    // Esc closes the fixed layer when there is no native full screen
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-full') && !isNative()) setFull(false);
    });

    apply(50);

    // once, when the figure is well in view: sweep the divider to show it moves
    if (reduceMotion) return;
    const watch = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        watch.disconnect();
        if (touched) return;
        hint = animate(state, {
          pos: [
            { to: 34, duration: 620 },
            { to: 66, duration: 900 },
            { to: 50, duration: 680 },
          ],
          ease: 'inOutSine',
          delay: 350,
          onUpdate: () => apply(state.pos),
        });
      },
      { threshold: 0.6 },
    );
    watch.observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-compare]').forEach(setupCompare);
</script>
