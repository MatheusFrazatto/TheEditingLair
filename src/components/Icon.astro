---
interface Props {
  name: 'download' | 'external' | 'arrow' | 'rss' | 'back';
}
const { name } = Astro.props;
---
<svg class={`icon icon--${name}`} viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
  {name === 'download' && <path d="M10 2v11M4.5 8.5 10 14l5.5-5.5M2 18h16" />}
  {name === 'external' && <path d="M8 3H3v14h14v-5M11 2h7v7M18 2 9 11" />}
  {name === 'arrow' && <path d="M2 10h15M11.5 4.5 17 10l-5.5 5.5" />}
  {name === 'back' && <path d="M18 10H3M8.5 4.5 3 10l5.5 5.5" />}
  {name === 'rss' && <path d="M3 3a14 14 0 0 1 14 14M3 9a8 8 0 0 1 8 8M4 16.5h.5" />}
</svg>
