---
import type { CollectionEntry } from 'astro:content';

interface Props {
  plugin: CollectionEntry<'plugins'>;
}

const { features } = Astro.props.plugin.data;
---
{features.length > 0 && (
  <section class="brief">
    <h3 class="legend brief__title">What it does</h3>
    <ul class="brief__features">
      {features.map((feature) => <li>{feature}</li>)}
    </ul>
  </section>
)}

<style>
  .brief {
    padding-top: 10px;
    border-top: 1px solid var(--z0);
  }
  .brief__title {
    margin: 0 0 6px;
    font-size: 0.8125rem;
    color: var(--z4);
  }
  .brief__features {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .brief__features li {
    position: relative;
    padding: 8px 0 8px 18px;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--z0);
    text-wrap: pretty;
  }
  .brief__features li + li {
    border-top: 1px solid var(--z8);
  }
  /* the square pin of a node input */
  .brief__features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(8px + 0.65em - 3.5px);
    width: 7px;
    height: 7px;
    background: var(--z0);
  }
</style>
