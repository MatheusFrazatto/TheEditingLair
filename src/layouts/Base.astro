---
import '../styles/global.css';
import Wedge from '../components/Wedge.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Intro from '../components/Intro.astro';
import { getImage } from 'astro:assets';
import { withBase } from '../lib/url';
import shareDefault from '../assets/share-default.jpg';

interface ShareImage {
  src: string;
  width: number;
  height: number;
  alt?: string;
}

interface Props {
  title?: string;
  description?: string;
  wedge?: 'full' | 'compact';
  current?: 'plugins' | 'notes' | 'about';
  /** The picture a shared link shows; the site card when left out. */
  image?: ShareImage;
  /** schema.org data describing the page for search engines. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'DaVinci Resolve Fusion macros and notes on editing, made by Cadenzy.',
  wedge = 'compact',
  current,
} = Astro.props;

const fullTitle = title ? `${title} | The Editing Lair` : 'The Editing Lair: Fusion tools and notes for DaVinci Resolve';
const canonical = new URL(Astro.url.pathname, Astro.site);

const share: ShareImage = Astro.props.image ?? {
  src: (await getImage({ src: shareDefault, format: 'jpg' })).src,
  width: shareDefault.width,
  height: shareDefault.height,
  alt: 'The Editing Lair, under a grey step wedge from black to white.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="The Editing Lair: Notes" href={withBase('rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title="The Editing Lair: Plugin updates" href={withBase('plugins.xml')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta name="theme-color" content="#1a1a1a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="The Editing Lair" />
    <meta property="og:image" content={new URL(share.src, Astro.site)} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    {share.alt && <meta property="og:image:alt" content={share.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {Astro.props.jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(Astro.props.jsonLd).replace(/</g, '\\u003c')} />
    )}
    <script is:inline>
      // Decide before first paint: hold the home entrance for motion.ts, and
      // play the intro once per session. Both release on their own if the
      // motion script never runs.
      (function () {
        var d = document.documentElement;
        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          d.dataset.motion = 'on';
          setTimeout(function () { d.dataset.motion = 'ready'; }, 3500);
          if (!sessionStorage.getItem('tel-intro')) {
            sessionStorage.setItem('tel-intro', '1');
            d.dataset.intro = 'play';
            setTimeout(function () { if (d.dataset.intro === 'play') d.dataset.intro = 'done'; }, 4500);
          }
        } catch (e) {
          d.dataset.motion = 'ready';
        }
      })();
    </script>
  </head>
  <body>
    <Intro />
    <a class="skip" href="#content">Skip to content</a>
    <Wedge size={wedge} current={current} />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
