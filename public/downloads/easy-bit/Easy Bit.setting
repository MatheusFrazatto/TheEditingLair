						GreenExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.1294 + (1 - min(1, abs(i1 - 1)))*0.2667 + (1 - min(1, abs(i1 - 2)))*0.4078 + (1 - min(1, abs(i1 - 3)))*0.7059)*a1", },
						BlueExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.2157 + (1 - min(1, abs(i1 - 1)))*0.3843 + (1 - min(1, abs(i1 - 2)))*0.4078 + (1 - min(1, abs(i1 - 3)))*0.6314)*a1", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Pal_PokemonSGB",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1320, 66 } },
				},
				-- SpaceHaze: 4-tone ramp (Lospec), mapped by block luma: tone = floor(L * 4), colours sorted dark to light.
				-- The source is un-premultiplied (divided by alpha) before matching and
				-- the result re-multiplied by alpha, so transparent areas stay empty
				-- instead of turning into the darkest palette colour.
				-- Only active when Palette = SpaceHaze (Blend), otherwise Image1 passes through.
				Pal_SpaceHaze = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Palette == 16, 1, 0)", },
						Intermediate1 = Input { Value = "max(0, min(3, floor((0.299*(r2/max(a2, 0.000001)) + 0.587*(g2/max(a2, 0.000001)) + 0.114*(b2/max(a2, 0.000001)))*4)))", },
						RedExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.0431 + (1 - min(1, abs(i1 - 1)))*0.4196 + (1 - min(1, abs(i1 - 2)))*0.8000 + (1 - min(1, abs(i1 - 3)))*0.9725)*a1", },
						GreenExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.0235 + (1 - min(1, abs(i1 - 1)))*0.1216 + (1 - min(1, abs(i1 - 2)))*0.2039 + (1 - min(1, abs(i1 - 3)))*0.8902)*a1", },
						BlueExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.1882 + (1 - min(1, abs(i1 - 1)))*0.6941 + (1 - min(1, abs(i1 - 2)))*0.5843 + (1 - min(1, abs(i1 - 3)))*0.7686)*a1", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Pal_RusticGB",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1375, 66 } },
				},
				-- Velvet Cherry GB: 4-tone ramp (Lospec), mapped by block luma: tone = floor(L * 4), colours sorted dark to light.
				-- The source is un-premultiplied (divided by alpha) before matching and
				-- the result re-multiplied by alpha, so transparent areas stay empty
				-- instead of turning into the darkest palette colour.
				-- Only active when Palette = Velvet Cherry GB (Blend), otherwise Image1 passes through.
				Pal_VelvetCherryGB = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Palette == 17, 1, 0)", },
						Intermediate1 = Input { Value = "max(0, min(3, floor((0.299*(r2/max(a2, 0.000001)) + 0.587*(g2/max(a2, 0.000001)) + 0.114*(b2/max(a2, 0.000001)))*4)))", },
						RedExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.1765 + (1 - min(1, abs(i1 - 1)))*0.2549 + (1 - min(1, abs(i1 - 2)))*0.4078 + (1 - min(1, abs(i1 - 3)))*0.5922)*a1", },
						GreenExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.0863 + (1 - min(1, abs(i1 - 1)))*0.1529 + (1 - min(1, abs(i1 - 2)))*0.2275 + (1 - min(1, abs(i1 - 3)))*0.4588)*a1", },
						BlueExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.1725 + (1 - min(1, abs(i1 - 1)))*0.3216 + (1 - min(1, abs(i1 - 2)))*0.4078 + (1 - min(1, abs(i1 - 3)))*0.6510)*a1", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Pal_SpaceHaze",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1430, 66 } },
				},
				-- Block glitch (v1.1.0): runs on the small image, before the
				-- frame repeat, so it steps with the rest of the picture and
				-- shifts whole blocks (nothing blurs, the grid stays aligned).
				-- Rows are grouped into bands of s1 = Glitch Size blocks. Per
				-- band and frame, a sine hash r = fract(sin(seed) * 43758.5453)
				-- decides whether the band jumps (probability s2 = 0.35 * Glitch)
				-- and by how many whole blocks (up to s3 = 1 + 15% of the width
				-- at Glitch 1). A per-frame hash also gates whole frames
				-- (probability Glitch), so glitches come in bursts instead of on
				-- every frame. Sampling wraps around the frame edges.
				Glitch = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Glitch == 0, 0, 1)", },
						NumberIn1 = Input { Value = 0, Expression = "Labels.Glitch", },
						NumberIn2 = Input { Value = 2, Expression = "Labels.GlitchSize", },
						Setup1 = Input { Value = "max(1, floor(n2 + 0.5))", },
						Setup2 = Input { Value = "0.1 + 0.25*n1", },
						Setup3 = Input { Value = "1 + n1*0.15*w", },
						Setup4 = Input { Value = "sqrt(n1)", },
						Intermediate1 = Input { Value = "min(1, max(0, (s4 - (sin(time*91.7 + 3.1)*43758.5453 - floor(sin(time*91.7 + 3.1)*43758.5453)))*1000000)) * min(1, max(0, (s2 - (sin(floor(y*h/s1)*12.9898 + time*78.233 + 1.3)*43758.5453 - floor(sin(floor(y*h/s1)*12.9898 + time*78.233 + 1.3)*43758.5453)))*1000000)) * (2*floor((sin(floor(y*h/s1)*12.9898 + time*78.233 + 1.3 + 1.7)*43758.5453 - floor(sin(floor(y*h/s1)*12.9898 + time*78.233 + 1.3 + 1.7)*43758.5453))*2) - 1) * (1 + floor(((sin(floor(y*h/s1)*12.9898 + time*78.233 + 1.3 + 1.7)*43758.5453 - floor(sin(floor(y*h/s1)*12.9898 + time*78.233 + 1.3 + 1.7)*43758.5453))*7.31 - floor((sin(floor(y*h/s1)*12.9898 + time*78.233 + 1.3 + 1.7)*43758.5453 - floor(sin(floor(y*h/s1)*12.9898 + time*78.233 + 1.3 + 1.7)*43758.5453))*7.31))*s3)) / w", },
						RedExpression = Input { Value = "getr1w(x + i1, y)", },
						GreenExpression = Input { Value = "getg1w(x + i1, y)", },
						BlueExpression = Input { Value = "getb1w(x + i1, y)", },
						AlphaExpression = Input { Value = "geta1w(x + i1, y)", },
						Image1 = Input {
							SourceOp = "Pal_VelvetCherryGB",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1045, 33 } },
				},
				FrameHold = ofx.com.blackmagicdesign.resolvefx.StopMotion {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Source = Input {
							SourceOp = "Glitch",
							Source = "Output",
						},
						advancedGroup = Input { Value = 0, },
						setReferenceButton = Input { Value = 0, },
						referenceFrame = Input {
							Value = 0,
							Disabled = true,
						},
						frameRepeatVar = Input { Value = 0, },
						frameRepeat = Input { Value = 2, },
						blendGroup = Input { Value = 0, },
						blendIn = Input { Value = 1, },
						blend = Input { Value = 0, },
						ignoreContentShape = Input { Value = 0, },
						legacyIsProcessRGBOnly = Input { Value = 0, },
						IsNoTemporalFramesReqd = Input { Value = 0, },
						srcProcessingAlphaMode = Input { Value = -1, },
						dstProcessingAlphaMode = Input { Value = -1, },
						resolvefxVersion = Input { Value = "1.0", }
					},
					ViewInfo = OperatorInfo { Pos = { 1100, 0 } },
				},
				-- Back to full size the same way Easy Dither scales its pattern
				-- tile: a Merge whose foreground (one pixel per block) is scaled
				-- by the integer block size with Nearest filtering
				-- (FilterMethod 0), so blocks stay hard-edged. The foreground's
				-- bottom-left corner is pinned to the canvas corner, so the
				-- rounded-up overhang falls off the top/right edge.
				Canvas = Background {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, Expression = "InputRouter.Output.Width", },
						Height = Input { Value = 1080, Expression = "InputRouter.Output.Height", },
						UseFrameFormatSettings = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 1210, 33 } },
				},
				Upscale = Merge {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "FrameHold",
							Source = "Output",
						},
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(Downscale.Width * max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)) / (2 * InputRouter.Output.Width), Downscale.Height * max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)) / (2 * InputRouter.Output.Height))",
						},
						Size = Input {
							Value = 6,
							Expression = "max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5))",
						},
						FilterMethod = Input { Value = 0, },
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 1210, 0 } },
				},
				----------------------------------------------------------------
				-- SCREEN (v1.1.0): pixel grid -> RGB shift -> glow, all
				-- at full size after the upscale. Each stage passes through
				-- (Blend 0) while its control is off/zero.
				----------------------------------------------------------------
				-- Pixel grid: one C x C cell (C = block size) drawn by a Custom
				-- Tool on a tiny canvas: lit area 1, a gap of g whole pixels on
				-- the right and top edges (g = round(C * Thickness), at least 1)
				-- darkened by Grid Darkness. The cell is tiled across the frame
				-- (Merge Edges = Wrap), pinned bottom-left like the blocks, and
				-- multiplied over the image. Process Alpha is off, so only RGB is
				-- darkened and transparent areas stay transparent.
				GridBase = Background {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 6, Expression = "max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5))", },
						Height = Input { Value = 6, Expression = "max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5))", },
						UseFrameFormatSettings = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 1430, 66 } },
				},
				GridCell = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						NumberIn1 = Input { Value = 0.2, Expression = "Labels.GridThickness", },
						NumberIn2 = Input { Value = 1, Expression = "Labels.GridDarkness", },
						Setup1 = Input { Value = "max(1, floor(w*n1 + 0.5))", },
						Intermediate1 = Input { Value = "min(1, max(0, (w - s1) - floor(x*w))) * min(1, max(0, (h - s1) - floor(y*h)))", },
						RedExpression = Input { Value = "1 - n2*(1 - i1)", },
						GreenExpression = Input { Value = "1 - n2*(1 - i1)", },
						BlueExpression = Input { Value = "1 - n2*(1 - i1)", },
						AlphaExpression = Input { Value = "1", },
						Image1 = Input {
							SourceOp = "GridBase",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1430, 33 } },
				},
				Grid = Merge {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "Labels.GridOn", },
						ProcessAlpha = Input { Value = 0, },
						Background = Input {
							SourceOp = "Upscale",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "GridCell",
							Source = "Output",
						},
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)) / (2 * InputRouter.Output.Width), max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)) / (2 * InputRouter.Output.Height))",
						},
						Edges = Input { Value = 1, },
						FilterMethod = Input { Value = 0, },
						ApplyMode = Input { Value = FuID { "Multiply" }, },
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 1430, 0 } },
				},
				-- RGB shift in two Transforms, using the per-channel Process
				-- switches (Settings tab): the first moves only red to the left,
				-- the second only blue to the right; green and alpha are left as
				-- they are. Shift is whole pixels (RGB Shift scaled by
				-- min(W, H) / 1080). Both pass through while RGB Shift is 0.
				ShiftRed = Transform {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.RGBShift == 0, 0, 1)", },
						ProcessGreen = Input { Value = 0, },
						ProcessBlue = Input { Value = 0, },
						ProcessAlpha = Input { Value = 0, },
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5 - floor(Labels.RGBShift * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5) / InputRouter.Output.Width, 0.5)",
						},
						Edges = Input { Value = 3, },
						Input = Input {
							SourceOp = "Grid",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1540, 0 } },
				},
				ShiftBlue = Transform {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.RGBShift == 0, 0, 1)", },
						ProcessRed = Input { Value = 0, },
						ProcessGreen = Input { Value = 0, },
						ProcessAlpha = Input { Value = 0, },
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5 + floor(Labels.RGBShift * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5) / InputRouter.Output.Width, 0.5)",
						},
						Edges = Input { Value = 3, },
						Input = Input {
							SourceOp = "ShiftRed",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1650, 0 } },
				},
				Glow = SoftGlow {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Gain == 0, 0, 1)", },
						Filter = Input { Value = FuID { "Fast Gaussian" }, },
						Threshold = Input { Value = 0.4, },
						Gain = Input { Value = 0, },
						XGlowSize = Input { Value = 10, },
						Input = Input {
							SourceOp = "ShiftBlue",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1650, 0 } },
				},
				Mix = Dissolve {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Mix = Input { Value = 1, },
						Background = Input {
							SourceOp = "InputRouter",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Glow",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 1430, 0 } },
				},
				-- Holds the header, section labels and Pixel Size / Palette
				-- controls; never rendered.
				Labels = Merge {
					PassThrough = true,
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						PerformDepthMerge = Input { Value = 0, },
						PixelLabel = Input { Value = 1, },
						ColorLabel = Input { Value = 1, },
						MotionLabel = Input { Value = 1, },
						ScreenLabel = Input { Value = 1, },
						GridOn = Input { Value = 0, },
						GridThickness = Input { Value = 0.2, },
						GridDarkness = Input { Value = 1, },
						RGBShift = Input { Value = 0, },
						Glitch = Input { Value = 0, },
						GlitchSize = Input { Value = 2, },
						ToneLabel = Input { Value = 0, },
						PixelSize = Input { Value = 6, },
						Texture = Input { Value = 0, },
						Palette = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 0, 66 } },
					UserControls = ordered() {
						-- Title as a full-width button: Fusion always centres button
						-- text, while a LabelControl stays left-aligned. No action.
						Header = {
							LINKS_Name = "Easy Bit  |  v2.0.0",
							LINKID_DataType = "Number",
							INPID_InputControl = "ButtonControl",
							INP_Integer = true,
							ICD_Width = 1,
							INP_External = false,
							ICS_ControlPage = "Controls",
						},
						MadeByButton = {
							LINKS_Name = "Made by Cadenzy", BTNCS_Execute = "bmd.openurl(\"https://matheusfrazatto.github.io/TheEditingLair/about/\")",
							LINKID_DataType = "Number",
							INPID_InputControl = "ButtonControl",
							INP_Integer = true,
							ICD_Width = 1,
							INP_External = false,
							ICS_ControlPage = "Controls",
						},
						SiteButton = {
							LINKS_Name = "The Editing Lair", BTNCS_Execute = "bmd.openurl(\"https://matheusfrazatto.github.io/TheEditingLair/\")",
							LINKID_DataType = "Number",
							INPID_InputControl = "ButtonControl",
							INP_Integer = true,
							ICD_Width = 1,
							INP_External = false,
							ICS_ControlPage = "Controls",
						},
						PixelLabel = {
							LINKS_Name = "Pixel",
							LINKID_DataType = "Number",
							INPID_InputControl = "LabelControl",
							LBLC_DropDownButton = true,
							LBLC_NumInputs = 3,
							LBLC_NestLevel = 1,
							INP_Default = 1,
							INP_External = false,
							INP_Passive = true,
							ICS_ControlPage = "Controls",
						},
						ColorLabel = {
							LINKS_Name = "Color",
							LINKID_DataType = "Number",
							INPID_InputControl = "LabelControl",
							LBLC_DropDownButton = true,
							LBLC_NumInputs = 3,
							LBLC_NestLevel = 1,
							INP_Default = 1,
							INP_External = false,
							INP_Passive = true,
							ICS_ControlPage = "Controls",
						},
						MotionLabel = {
							LINKS_Name = "Motion",
							LINKID_DataType = "Number",
							INPID_InputControl = "LabelControl",
							LBLC_DropDownButton = true,
							LBLC_NumInputs = 1,
							LBLC_NestLevel = 1,
							INP_Default = 1,
							INP_External = false,
							INP_Passive = true,
							ICS_ControlPage = "Controls",
						},
						ScreenLabel = {
							LINKS_Name = "Screen",
							LINKID_DataType = "Number",
							INPID_InputControl = "LabelControl",
							LBLC_DropDownButton = true,
							LBLC_NumInputs = 8,
							LBLC_NestLevel = 1,
							INP_Default = 1,
							INP_External = false,
							INP_Passive = true,
							ICS_ControlPage = "Controls",
						},
						GridOn = {
							LINKS_Name = "Pixel Grid",
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							INP_Integer = true,
							INP_Default = 0,
							ICS_ControlPage = "Controls",
						},
						-- Gap width as a fraction of the block, rounded to whole pixels
						GridThickness = {
							LINKS_Name = "Grid Thickness",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0.2,
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 0.9,
							ICS_ControlPage = "Controls",
						},
						GridDarkness = {
							LINKS_Name = "Grid Darkness",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						-- Pixels at 1080p (scaled with resolution, rounded)
						RGBShift = {
							LINKS_Name = "RGB Shift",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 10,
							INP_MinAllowed = 0,
							ICS_ControlPage = "Controls",
						},
						-- 0 = off; higher = more bands jump, and further
						Glitch = {
							LINKS_Name = "Glitch",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						-- Band height in blocks
						GlitchSize = {
							LINKS_Name = "Glitch Size",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 2,
							INP_MinScale = 1,
							INP_MaxScale = 10,
							INP_MinAllowed = 1,
							ICS_ControlPage = "Controls",
						},
						ToneLabel = {
							LINKS_Name = "Tone",
							LINKID_DataType = "Number",
							INPID_InputControl = "LabelControl",
							LBLC_DropDownButton = true,
							LBLC_NumInputs = 4,
							LBLC_NestLevel = 1,
							INP_Default = 0,
							INP_External = false,
							INP_Passive = true,
							ICS_ControlPage = "Controls",
						},
						PixelSize = {
							LINKS_Name = "Pixel Size",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 6,
							INP_MinScale = 1,
							INP_MaxScale = 32,
							INP_MinAllowed = 1,
