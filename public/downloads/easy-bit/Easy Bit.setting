				},
				-- PICO-8: 16 colours (Lospec). Each block snaps to the nearest colour by
				-- luma-weighted RGB distance; i1 = smallest distance, and each
				-- channel sums the colour whose distance equals it. min() and the
				-- sums are balanced trees to keep nesting shallow. Only active when
				-- Palette = PICO-8 (Blend), otherwise Image1 passes through.
				Pal_PICO8 = Custom {
