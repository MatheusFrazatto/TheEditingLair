{
	Tools = ordered() {
		EasyBit = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "InputRouter",
					Source = "Input",
				},

				----------------------------------------------------------------
				-- Pipeline: tone -> smooth -> shrink to one pixel per block ->
				-- posterize + recolour -> console palette -> frame repeat ->
				-- integer nearest upscale -> mix. All colour work runs on
				-- the small image, so palette matching stays cheap.
				-- Section headers are collapsible LabelControls on "Labels":
				-- each hides the next LBLC_NumInputs controls.
				----------------------------------------------------------------
				ControlsPage = Input {
					Type = "Page",
					Page = "Controls",
				},
				Labels_Header = InstanceInput {
					SourceOp = "Labels",
					Source = "Header",
					Page = "Controls",
					Width = 1,
				},
				-- The Cadenzy and site buttons open The Editing Lair (bmd.openurl).
				Labels_MadeByButton = InstanceInput {
					SourceOp = "Labels",
					Source = "MadeByButton",
					Page = "Controls",
					Width = 1,
				},
				Labels_SiteButton = InstanceInput {
					SourceOp = "Labels",
					Source = "SiteButton",
					Page = "Controls",
					Width = 1,
				},
				Mix_Mix = InstanceInput {
					SourceOp = "Mix",
					Source = "Mix",
					Name = "Mix",
					Page = "Controls",
					Default = 1,
				},

				-- PIXEL: block size and pre-smoothing
				Labels_PixelLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "PixelLabel",
					Page = "Controls",
					Default = 1,
				},
				Labels_PixelSize = InstanceInput {
					SourceOp = "Labels",
					Source = "PixelSize",
					Default = 6,
				},
				Labels_Texture = InstanceInput {
					SourceOp = "Labels",
					Source = "Texture",
					Default = 0,
				},
				Smooth_XBlurSize = InstanceInput {
					SourceOp = "Smooth",
					Source = "XBlurSize",
					Name = "Smoothness",
					MinScale = 0,
					MaxScale = 20,
					Default = 0,
				},

				-- COLOR: console palette, or free posterize when Palette = None
				Labels_ColorLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "ColorLabel",
					Page = "Controls",
					Default = 1,
				},
				Labels_Palette = InstanceInput {
					SourceOp = "Labels",
					Source = "Palette",
					Default = 0,
				},
				Posterize_NumberIn1 = InstanceInput {
					SourceOp = "Posterize",
					Source = "NumberIn1",
					Name = "Color Steps",
					Default = 3,
				},
				Recolor_Blend = InstanceInput {
					SourceOp = "Recolor",
					Source = "Blend",
					Name = "Color Mix",
					Default = 1,
				},

				-- MOTION: held frames for a low frame-rate look
				Labels_MotionLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "MotionLabel",
					Page = "Controls",
					Default = 1,
				},
				FrameHold_frameRepeat = InstanceInput {
					SourceOp = "FrameHold",
					Source = "frameRepeat",
					Name = "Frame Repeat",
					Default = 5,
				},

				-- TONE: grade applied before pixelating, so it shapes which
				-- palette colours get picked instead of tinting them afterwards
				Labels_ToneLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "ToneLabel",
					Page = "Controls",
					Default = 0,
				},
				Tone_Brightness = InstanceInput {
					SourceOp = "Tone",
					Source = "Brightness",
					Default = 0,
				},
				Tone_Contrast = InstanceInput {
					SourceOp = "Tone",
					Source = "Contrast",
					Default = 0,
				},
				Tone_Gamma = InstanceInput {
					SourceOp = "Tone",
					Source = "Gamma",
					Default = 1,
				},
				Tone_Saturation = InstanceInput {
					SourceOp = "Tone",
					Source = "Saturation",
					Default = 1,
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Mix",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				InputRouter = PipeRouter {
					CtrlWShown = false,
					NameSet = true,
					ViewInfo = PipeRouterInfo { Pos = { 0, 0 } },
				},
				Tone = BrightnessContrast {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Alpha = Input { Value = 1, },
						ClipBlack = Input { Value = 1, },
						ClipWhite = Input { Value = 1, },
						Input = Input {
							SourceOp = "InputRouter",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Smooth = Blur {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Filter = Input { Value = FuID { "Gaussian" }, },
						XBlurSize = Input { Value = 0, },
						Input = Input {
							SourceOp = "Tone",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				-- One pixel per block. Block C = round(Pixel Size * min(W, H) /
				-- 1080) whole pixels, size rounded up so the later upscale is an
				-- exact integer factor (fractional blocks alternate sizes and
				-- show as stripes); the overhang is cropped at the end. Box
				-- filtering averages each block, which also removes noise.
				Downscale = BetterResize {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Width = Input {
							Value = 320,
							Expression = "floor((InputRouter.Output.Width + max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)) - 1) / max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)))",
						},
						Height = Input {
							Value = 180,
							Expression = "floor((InputRouter.Output.Height + max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)) - 1) / max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)))",
						},
						KeepAspect = Input { Value = 0, },
						FilterMethod = Input { Value = 1, },
						Input = Input {
							SourceOp = "Smooth",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				-- Texture. Clean (0): passes the box-averaged block through, so
				-- sensor noise is averaged away before posterizing. Gritty (1):
				-- point-samples one source pixel at each block centre instead,
				-- so noise survives as speckles and harder contrast (the look
				-- of posterizing per pixel before pixelating). Runs on the small
				-- image: Image1 = Downscale (size), Image2 = full-res Smooth.
				Sample = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Texture == 1, 1, 0)", },
						RedExpression = Input { Value = "getr2d((floor(x*w)+0.5)/w, (floor(y*h)+0.5)/h)", },
						GreenExpression = Input { Value = "getg2d((floor(x*w)+0.5)/w, (floor(y*h)+0.5)/h)", },
						BlueExpression = Input { Value = "getb2d((floor(x*w)+0.5)/w, (floor(y*h)+0.5)/h)", },
						AlphaExpression = Input { Value = "geta2d((floor(x*w)+0.5)/w, (floor(y*h)+0.5)/h)", },
						Image1 = Input {
							SourceOp = "Downscale",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Smooth",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 385, 33 } },
				},
				-- n1 steps per channel: (ceil(c*n)/n - 1/n) / (1 - 1/n) maps to
				-- n evenly spaced levels 0..1, clamped at 0. Alpha untouched.
				Posterize = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						NumberIn1 = Input { Value = 3, },
						Setup1 = Input { Value = "1/max(2, n1)", },
						RedExpression = Input { Value = "max(0, (ceil(r1*max(2, n1))*s1 - s1) / (1 - s1))", },
						GreenExpression = Input { Value = "max(0, (ceil(g1*max(2, n1))*s1 - s1) / (1 - s1))", },
						BlueExpression = Input { Value = "max(0, (ceil(b1*max(2, n1))*s1 - s1) / (1 - s1))", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						NumberIn1 = {
							LINKS_Name = "Color Steps",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 3,
							INP_MinScale = 2,
							INP_MaxScale = 16,
							INP_MinAllowed = 2,
							ICS_ControlPage = "Controls",
						},
					},
				},
				-- Color Mix: luminance from the posterized blocks, hue and
				-- saturation from the plain blocks.
				Recolor = Merge {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 1, },
						Background = Input {
							SourceOp = "Posterize",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
						ApplyMode = Input { Value = FuID { "Color" }, },
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
				},
				-- CGA: 4 colours (Lospec). Each block snaps to the nearest colour by
				-- luma-weighted RGB distance; i1 = smallest distance, and each
				-- channel sums the colour whose distance equals it. min() and the
				-- sums are balanced trees to keep nesting shallow. Only active when
				-- Palette = CGA (Blend), otherwise Image1 passes through.
				Pal_CGA = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Palette == 1, 1, 0)", },
						Intermediate1 = Input { Value = "min(min(((r2-0.0000)*(r2-0.0000)*0.299+(g2-0.0000)*(g2-0.0000)*0.587+(b2-0.0000)*(b2-0.0000)*0.114), ((r2-1.0000)*(r2-1.0000)*0.299+(g2-0.3333)*(g2-0.3333)*0.587+(b2-1.0000)*(b2-1.0000)*0.114)), min(((r2-0.3333)*(r2-0.3333)*0.299+(g2-1.0000)*(g2-1.0000)*0.587+(b2-1.0000)*(b2-1.0000)*0.114), ((r2-1.0000)*(r2-1.0000)*0.299+(g2-1.0000)*(g2-1.0000)*0.587+(b2-1.0000)*(b2-1.0000)*0.114)))", },
						RedExpression = Input { Value = "(((1-min(1,(((r2-1.0000)*(r2-1.0000)*0.299+(g2-0.3333)*(g2-0.3333)*0.587+(b2-1.0000)*(b2-1.0000)*0.114)-i1)*10000000))*1.0000 + (1-min(1,(((r2-0.3333)*(r2-0.3333)*0.299+(g2-1.0000)*(g2-1.0000)*0.587+(b2-1.0000)*(b2-1.0000)*0.114)-i1)*10000000))*0.3333) + (1-min(1,(((r2-1.0000)*(r2-1.0000)*0.299+(g2-1.0000)*(g2-1.0000)*0.587+(b2-1.0000)*(b2-1.0000)*0.114)-i1)*10000000))*1.0000)", },
						GreenExpression = Input { Value = "(((1-min(1,(((r2-1.0000)*(r2-1.0000)*0.299+(g2-0.3333)*(g2-0.3333)*0.587+(b2-1.0000)*(b2-1.0000)*0.114)-i1)*10000000))*0.3333 + (1-min(1,(((r2-0.3333)*(r2-0.3333)*0.299+(g2-1.0000)*(g2-1.0000)*0.587+(b2-1.0000)*(b2-1.0000)*0.114)-i1)*10000000))*1.0000) + (1-min(1,(((r2-1.0000)*(r2-1.0000)*0.299+(g2-1.0000)*(g2-1.0000)*0.587+(b2-1.0000)*(b2-1.0000)*0.114)-i1)*10000000))*1.0000)", },
						BlueExpression = Input { Value = "(((1-min(1,(((r2-1.0000)*(r2-1.0000)*0.299+(g2-0.3333)*(g2-0.3333)*0.587+(b2-1.0000)*(b2-1.0000)*0.114)-i1)*10000000))*1.0000 + (1-min(1,(((r2-0.3333)*(r2-0.3333)*0.299+(g2-1.0000)*(g2-1.0000)*0.587+(b2-1.0000)*(b2-1.0000)*0.114)-i1)*10000000))*1.0000) + (1-min(1,(((r2-1.0000)*(r2-1.0000)*0.299+(g2-1.0000)*(g2-1.0000)*0.587+(b2-1.0000)*(b2-1.0000)*0.114)-i1)*10000000))*1.0000)", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Recolor",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 660, 0 } },
				},
				-- Game Boy: 4 colours (Lospec). Each block snaps to the nearest colour by
				-- luma-weighted RGB distance; i1 = smallest distance, and each
				-- channel sums the colour whose distance equals it. min() and the
				-- sums are balanced trees to keep nesting shallow. Only active when
				-- Palette = Game Boy (Blend), otherwise Image1 passes through.
				Pal_GameBoy = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Palette == 2, 1, 0)", },
						Intermediate1 = Input { Value = "min(min(((r2-0.0588)*(r2-0.0588)*0.299+(g2-0.2196)*(g2-0.2196)*0.587+(b2-0.0588)*(b2-0.0588)*0.114), ((r2-0.1882)*(r2-0.1882)*0.299+(g2-0.3843)*(g2-0.3843)*0.587+(b2-0.1882)*(b2-0.1882)*0.114)), min(((r2-0.5451)*(r2-0.5451)*0.299+(g2-0.6745)*(g2-0.6745)*0.587+(b2-0.0588)*(b2-0.0588)*0.114), ((r2-0.6078)*(r2-0.6078)*0.299+(g2-0.7373)*(g2-0.7373)*0.587+(b2-0.0588)*(b2-0.0588)*0.114)))", },
						RedExpression = Input { Value = "(((1-min(1,(((r2-0.0588)*(r2-0.0588)*0.299+(g2-0.2196)*(g2-0.2196)*0.587+(b2-0.0588)*(b2-0.0588)*0.114)-i1)*10000000))*0.0588 + (1-min(1,(((r2-0.1882)*(r2-0.1882)*0.299+(g2-0.3843)*(g2-0.3843)*0.587+(b2-0.1882)*(b2-0.1882)*0.114)-i1)*10000000))*0.1882) + ((1-min(1,(((r2-0.5451)*(r2-0.5451)*0.299+(g2-0.6745)*(g2-0.6745)*0.587+(b2-0.0588)*(b2-0.0588)*0.114)-i1)*10000000))*0.5451 + (1-min(1,(((r2-0.6078)*(r2-0.6078)*0.299+(g2-0.7373)*(g2-0.7373)*0.587+(b2-0.0588)*(b2-0.0588)*0.114)-i1)*10000000))*0.6078))", },
						GreenExpression = Input { Value = "(((1-min(1,(((r2-0.0588)*(r2-0.0588)*0.299+(g2-0.2196)*(g2-0.2196)*0.587+(b2-0.0588)*(b2-0.0588)*0.114)-i1)*10000000))*0.2196 + (1-min(1,(((r2-0.1882)*(r2-0.1882)*0.299+(g2-0.3843)*(g2-0.3843)*0.587+(b2-0.1882)*(b2-0.1882)*0.114)-i1)*10000000))*0.3843) + ((1-min(1,(((r2-0.5451)*(r2-0.5451)*0.299+(g2-0.6745)*(g2-0.6745)*0.587+(b2-0.0588)*(b2-0.0588)*0.114)-i1)*10000000))*0.6745 + (1-min(1,(((r2-0.6078)*(r2-0.6078)*0.299+(g2-0.7373)*(g2-0.7373)*0.587+(b2-0.0588)*(b2-0.0588)*0.114)-i1)*10000000))*0.7373))", },
						BlueExpression = Input { Value = "(((1-min(1,(((r2-0.0588)*(r2-0.0588)*0.299+(g2-0.2196)*(g2-0.2196)*0.587+(b2-0.0588)*(b2-0.0588)*0.114)-i1)*10000000))*0.0588 + (1-min(1,(((r2-0.1882)*(r2-0.1882)*0.299+(g2-0.3843)*(g2-0.3843)*0.587+(b2-0.1882)*(b2-0.1882)*0.114)-i1)*10000000))*0.1882) + ((1-min(1,(((r2-0.5451)*(r2-0.5451)*0.299+(g2-0.6745)*(g2-0.6745)*0.587+(b2-0.0588)*(b2-0.0588)*0.114)-i1)*10000000))*0.0588 + (1-min(1,(((r2-0.6078)*(r2-0.6078)*0.299+(g2-0.7373)*(g2-0.7373)*0.587+(b2-0.0588)*(b2-0.0588)*0.114)-i1)*10000000))*0.0588))", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Pal_CGA",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 770, 0 } },
				},
				-- NES: 55 colours (Lospec). Each block snaps to the nearest colour by
				-- luma-weighted RGB distance; i1 = smallest distance, and each
				-- channel sums the colour whose distance equals it. min() and the
				-- sums are balanced trees to keep nesting shallow. Only active when
				-- Palette = NES (Blend), otherwise Image1 passes through.
				Pal_NES = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
