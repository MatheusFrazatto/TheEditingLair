{
	Tools = ordered() {
		EasyBit = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "InputRouter",
					Source = "Input",
				},

				----------------------------------------------------------------
				-- Pipeline: tone -> smooth -> shrink to one pixel per block ->
				-- posterize + recolour -> console palette -> frame repeat ->
				-- integer nearest upscale -> mix. All colour work runs on
				-- the small image, so palette matching stays cheap.
				-- Section headers are collapsible LabelControls on "Labels":
				-- each hides the next LBLC_NumInputs controls.
				----------------------------------------------------------------
				ControlsPage = Input {
					Type = "Page",
					Page = "Controls",
				},
				Labels_Header = InstanceInput {
					SourceOp = "Labels",
					Source = "Header",
					Page = "Controls",
					Width = 1,
				},
				-- The Cadenzy and site buttons open The Editing Lair (bmd.openurl).
				Labels_MadeByButton = InstanceInput {
					SourceOp = "Labels",
					Source = "MadeByButton",
					Page = "Controls",
					Width = 1,
				},
				Labels_SiteButton = InstanceInput {
					SourceOp = "Labels",
					Source = "SiteButton",
					Page = "Controls",
					Width = 1,
				},
				Mix_Mix = InstanceInput {
					SourceOp = "Mix",
					Source = "Mix",
					Name = "Mix",
					Page = "Controls",
					Default = 1,
				},

				-- PIXEL: block size and pre-smoothing
				Labels_PixelLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "PixelLabel",
					Page = "Controls",
					Default = 1,
				},
				Labels_PixelSize = InstanceInput {
					SourceOp = "Labels",
					Source = "PixelSize",
					Default = 6,
				},
				Labels_Texture = InstanceInput {
					SourceOp = "Labels",
					Source = "Texture",
					Default = 0,
				},
				Smooth_XBlurSize = InstanceInput {
					SourceOp = "Smooth",
					Source = "XBlurSize",
					Name = "Smoothness",
					MinScale = 0,
					MaxScale = 20,
					Default = 0,
				},

				-- COLOR: console palette, or free posterize when Palette = None
				Labels_ColorLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "ColorLabel",
					Page = "Controls",
					Default = 1,
				},
				Labels_Palette = InstanceInput {
					SourceOp = "Labels",
					Source = "Palette",
					Default = 0,
				},
				Posterize_NumberIn1 = InstanceInput {
					SourceOp = "Posterize",
					Source = "NumberIn1",
					Name = "Color Steps",
					Default = 3,
				},
				Recolor_Blend = InstanceInput {
					SourceOp = "Recolor",
					Source = "Blend",
					Name = "Color Mix",
					Default = 1,
				},

				-- SCREEN: console-display look on top of the pixels
				Labels_ScreenLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "ScreenLabel",
					Page = "Controls",
					Default = 1,
				},
				Labels_GridOn = InstanceInput {
					SourceOp = "Labels",
					Source = "GridOn",
					Default = 0,
				},
				Labels_GridThickness = InstanceInput {
					SourceOp = "Labels",
					Source = "GridThickness",
					Default = 0.2,
				},
				Labels_GridDarkness = InstanceInput {
					SourceOp = "Labels",
					Source = "GridDarkness",
					Default = 1,
				},
				Labels_RGBShift = InstanceInput {
					SourceOp = "Labels",
					Source = "RGBShift",
					Default = 0,
				},
				Glow_Gain = InstanceInput {
					SourceOp = "Glow",
					Source = "Gain",
					Name = "Glow",
					MinScale = 0,
					MaxScale = 2,
					Default = 0,
				},
				Glow_XGlowSize = InstanceInput {
					SourceOp = "Glow",
					Source = "XGlowSize",
					Name = "Glow Size",
					MinScale = 0,
					MaxScale = 40,
					Default = 10,
				},
				Labels_Glitch = InstanceInput {
					SourceOp = "Labels",
					Source = "Glitch",
					Default = 0,
				},
				Labels_GlitchSize = InstanceInput {
					SourceOp = "Labels",
					Source = "GlitchSize",
					Default = 2,
				},

				-- MOTION: held frames for a low frame-rate look
				Labels_MotionLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "MotionLabel",
					Page = "Controls",
					Default = 1,
				},
				FrameHold_frameRepeat = InstanceInput {
					SourceOp = "FrameHold",
					Source = "frameRepeat",
					Name = "Frame Repeat",
					Default = 2,
				},

				-- TONE: grade applied before pixelating, so it shapes which
				-- palette colours get picked instead of tinting them afterwards
				Labels_ToneLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "ToneLabel",
					Page = "Controls",
					Default = 0,
				},
				Tone_Brightness = InstanceInput {
					SourceOp = "Tone",
					Source = "Brightness",
					Default = 0,
				},
				Tone_Contrast = InstanceInput {
					SourceOp = "Tone",
					Source = "Contrast",
					Default = 0,
				},
				Tone_Gamma = InstanceInput {
					SourceOp = "Tone",
					Source = "Gamma",
					Default = 1,
				},
				Tone_Saturation = InstanceInput {
					SourceOp = "Tone",
					Source = "Saturation",
					Default = 1,
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Mix",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				InputRouter = PipeRouter {
					CtrlWShown = false,
					NameSet = true,
					ViewInfo = PipeRouterInfo { Pos = { 0, 0 } },
				},
				Tone = BrightnessContrast {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Alpha = Input { Value = 1, },
						ClipBlack = Input { Value = 1, },
						ClipWhite = Input { Value = 1, },
						Input = Input {
							SourceOp = "InputRouter",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				Smooth = Blur {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Filter = Input { Value = FuID { "Gaussian" }, },
						XBlurSize = Input { Value = 0, },
						Input = Input {
							SourceOp = "Tone",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				-- One pixel per block. Block C = round(Pixel Size * min(W, H) /
				-- 1080) whole pixels, size rounded up so the later upscale is an
				-- exact integer factor (fractional blocks alternate sizes and
				-- show as stripes); the overhang is cropped at the end. Box
				-- filtering averages each block, which also removes noise.
				Downscale = BetterResize {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Width = Input {
							Value = 320,
							Expression = "floor((InputRouter.Output.Width + max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)) - 1) / max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)))",
						},
						Height = Input {
							Value = 180,
							Expression = "floor((InputRouter.Output.Height + max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)) - 1) / max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)))",
						},
						KeepAspect = Input { Value = 0, },
						FilterMethod = Input { Value = 1, },
						Input = Input {
							SourceOp = "Smooth",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				-- Texture. Clean (0): passes the box-averaged block through, so
				-- sensor noise is averaged away before posterizing. Gritty (1):
				-- point-samples one source pixel at each block centre instead,
				-- so noise survives as speckles and harder contrast (the look
				-- of posterizing per pixel before pixelating). Runs on the small
				-- image: Image1 = Downscale (size), Image2 = full-res Smooth.
				Sample = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Texture == 1, 1, 0)", },
						RedExpression = Input { Value = "getr2d((floor(x*w)+0.5)/w, (floor(y*h)+0.5)/h)", },
						GreenExpression = Input { Value = "getg2d((floor(x*w)+0.5)/w, (floor(y*h)+0.5)/h)", },
						BlueExpression = Input { Value = "getb2d((floor(x*w)+0.5)/w, (floor(y*h)+0.5)/h)", },
						AlphaExpression = Input { Value = "geta2d((floor(x*w)+0.5)/w, (floor(y*h)+0.5)/h)", },
						Image1 = Input {
							SourceOp = "Downscale",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Smooth",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 385, 33 } },
				},
				-- n1 steps per channel: (ceil(c*n)/n - 1/n) / (1 - 1/n) maps to
				-- n evenly spaced levels 0..1, clamped at 0. Alpha untouched.
				Posterize = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						NumberIn1 = Input { Value = 3, },
						Setup1 = Input { Value = "1/max(2, n1)", },
						RedExpression = Input { Value = "max(0, (ceil(r1*max(2, n1))*s1 - s1) / (1 - s1))", },
						GreenExpression = Input { Value = "max(0, (ceil(g1*max(2, n1))*s1 - s1) / (1 - s1))", },
						BlueExpression = Input { Value = "max(0, (ceil(b1*max(2, n1))*s1 - s1) / (1 - s1))", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
					UserControls = ordered() {
						NumberIn1 = {
							LINKS_Name = "Color Steps",
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							INP_Default = 3,
							INP_MinScale = 2,
							INP_MaxScale = 16,
							INP_MinAllowed = 2,
							ICS_ControlPage = "Controls",
						},
					},
				},
				-- Color Mix: luminance from the posterized blocks, hue and
				-- saturation from the plain blocks.
				Recolor = Merge {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 1, },
						Background = Input {
							SourceOp = "Posterize",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
						ApplyMode = Input { Value = FuID { "Color" }, },
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 550, 0 } },
				},
				-- 2-bit Grayscale: 4-tone ramp (Lospec), mapped by block luma: tone = floor(L * 4), colours sorted dark to light.
				-- The source is un-premultiplied (divided by alpha) before matching and
				-- the result re-multiplied by alpha, so transparent areas stay empty
				-- instead of turning into the darkest palette colour.
				-- Only active when Palette = 2-bit Grayscale (Blend), otherwise Image1 passes through.
				Pal_2bitGrayscale = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Palette == 1, 1, 0)", },
						Intermediate1 = Input { Value = "max(0, min(3, floor((0.299*(r2/max(a2, 0.000001)) + 0.587*(g2/max(a2, 0.000001)) + 0.114*(b2/max(a2, 0.000001)))*4)))", },
						RedExpression = Input { Value = "((1 - min(1, abs(i1 - 1)))*0.4039 + (1 - min(1, abs(i1 - 2)))*0.7137 + (1 - min(1, abs(i1 - 3)))*1.0000)*a1", },
						GreenExpression = Input { Value = "((1 - min(1, abs(i1 - 1)))*0.4039 + (1 - min(1, abs(i1 - 2)))*0.7137 + (1 - min(1, abs(i1 - 3)))*1.0000)*a1", },
						BlueExpression = Input { Value = "((1 - min(1, abs(i1 - 1)))*0.4039 + (1 - min(1, abs(i1 - 2)))*0.7137 + (1 - min(1, abs(i1 - 3)))*1.0000)*a1", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Recolor",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 550, 66 } },
				},
				-- 2bit Demichrome: 4-tone ramp (Lospec), mapped by block luma: tone = floor(L * 4), colours sorted dark to light.
				-- The source is un-premultiplied (divided by alpha) before matching and
				-- the result re-multiplied by alpha, so transparent areas stay empty
				-- instead of turning into the darkest palette colour.
				-- Only active when Palette = 2bit Demichrome (Blend), otherwise Image1 passes through.
				Pal_2bitDemichrome = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Palette == 2, 1, 0)", },
						Intermediate1 = Input { Value = "max(0, min(3, floor((0.299*(r2/max(a2, 0.000001)) + 0.587*(g2/max(a2, 0.000001)) + 0.114*(b2/max(a2, 0.000001)))*4)))", },
						RedExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.1294 + (1 - min(1, abs(i1 - 1)))*0.3333 + (1 - min(1, abs(i1 - 2)))*0.6275 + (1 - min(1, abs(i1 - 3)))*0.9137)*a1", },
						GreenExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.1176 + (1 - min(1, abs(i1 - 1)))*0.3333 + (1 - min(1, abs(i1 - 2)))*0.6275 + (1 - min(1, abs(i1 - 3)))*0.9373)*a1", },
						BlueExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.1255 + (1 - min(1, abs(i1 - 1)))*0.4078 + (1 - min(1, abs(i1 - 2)))*0.5451 + (1 - min(1, abs(i1 - 3)))*0.9255)*a1", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Pal_2bitGrayscale",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 605, 66 } },
				},
				-- AYY4: 4-tone ramp (Lospec), mapped by block luma: tone = floor(L * 4), colours sorted dark to light.
				-- The source is un-premultiplied (divided by alpha) before matching and
				-- the result re-multiplied by alpha, so transparent areas stay empty
				-- instead of turning into the darkest palette colour.
				-- Only active when Palette = AYY4 (Blend), otherwise Image1 passes through.
				Pal_AYY4 = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Palette == 3, 1, 0)", },
						Intermediate1 = Input { Value = "max(0, min(3, floor((0.299*(r2/max(a2, 0.000001)) + 0.587*(g2/max(a2, 0.000001)) + 0.114*(b2/max(a2, 0.000001)))*4)))", },
						RedExpression = Input { Value = "((1 - min(1, abs(i1 - 1)))*1.0000 + (1 - min(1, abs(i1 - 2)))*1.0000 + (1 - min(1, abs(i1 - 3)))*0.9451)*a1", },
						GreenExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.1882 + (1 - min(1, abs(i1 - 1)))*0.4667 + (1 - min(1, abs(i1 - 2)))*0.8078 + (1 - min(1, abs(i1 - 3)))*0.9490)*a1", },
						BlueExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.2314 + (1 - min(1, abs(i1 - 1)))*0.4667 + (1 - min(1, abs(i1 - 2)))*0.5882 + (1 - min(1, abs(i1 - 3)))*0.8549)*a1", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Pal_2bitDemichrome",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 660, 66 } },
				},
				-- BLK AQU4: 4-tone ramp (Lospec), mapped by block luma: tone = floor(L * 4), colours sorted dark to light.
				-- The source is un-premultiplied (divided by alpha) before matching and
				-- the result re-multiplied by alpha, so transparent areas stay empty
				-- instead of turning into the darkest palette colour.
				-- Only active when Palette = BLK AQU4 (Blend), otherwise Image1 passes through.
				Pal_BLKAQU4 = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Palette == 4, 1, 0)", },
						Intermediate1 = Input { Value = "max(0, min(3, floor((0.299*(r2/max(a2, 0.000001)) + 0.587*(g2/max(a2, 0.000001)) + 0.114*(b2/max(a2, 0.000001)))*4)))", },
						RedExpression = Input { Value = "((1 - min(1, abs(i1 - 3)))*0.6235)*a1", },
						GreenExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.1686 + (1 - min(1, abs(i1 - 1)))*0.3725 + (1 - min(1, abs(i1 - 2)))*0.7255 + (1 - min(1, abs(i1 - 3)))*0.9569)*a1", },
						BlueExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.3490 + (1 - min(1, abs(i1 - 1)))*0.5490 + (1 - min(1, abs(i1 - 2)))*0.7451 + (1 - min(1, abs(i1 - 3)))*0.8980)*a1", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Pal_AYY4",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 715, 66 } },
				},
				-- Crimson: 4-tone ramp (Lospec), mapped by block luma: tone = floor(L * 4), colours sorted dark to light.
				-- The source is un-premultiplied (divided by alpha) before matching and
				-- the result re-multiplied by alpha, so transparent areas stay empty
				-- instead of turning into the darkest palette colour.
				-- Only active when Palette = Crimson (Blend), otherwise Image1 passes through.
				Pal_Crimson = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Value = 0, Expression = "iif(Labels.Palette == 5, 1, 0)", },
						Intermediate1 = Input { Value = "max(0, min(3, floor((0.299*(r2/max(a2, 0.000001)) + 0.587*(g2/max(a2, 0.000001)) + 0.114*(b2/max(a2, 0.000001)))*4)))", },
						RedExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.1059 + (1 - min(1, abs(i1 - 1)))*0.4784 + (1 - min(1, abs(i1 - 2)))*0.7294 + (1 - min(1, abs(i1 - 3)))*0.9373)*a1", },
						GreenExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.0118 + (1 - min(1, abs(i1 - 1)))*0.1098 + (1 - min(1, abs(i1 - 2)))*0.3137 + (1 - min(1, abs(i1 - 3)))*0.9765)*a1", },
						BlueExpression = Input { Value = "((1 - min(1, abs(i1 - 0)))*0.1490 + (1 - min(1, abs(i1 - 1)))*0.2941 + (1 - min(1, abs(i1 - 2)))*0.2667 + (1 - min(1, abs(i1 - 3)))*0.8392)*a1", },
						AlphaExpression = Input { Value = "a1", },
						Image1 = Input {
							SourceOp = "Pal_BLKAQU4",
							Source = "Output",
						},
						Image2 = Input {
							SourceOp = "Sample",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 770, 66 } },
				},
				-- Game Boy: 4 colours (classic DMG), nearest colour by luma-weighted RGB distance.
				-- The source is un-premultiplied (divided by alpha) before matching and
				-- the result re-multiplied by alpha, so transparent areas stay empty
				-- instead of turning into the darkest palette colour.
				-- Only active when Palette = Game Boy (Blend), otherwise Image1 passes through.
				Pal_GameBoy = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
