				-- Back to full size the same way Easy Dither scales its pattern
				-- tile: a Merge whose foreground (one pixel per block) is scaled
				-- by the integer block size with Nearest filtering
				-- (FilterMethod 0), so blocks stay hard-edged. The foreground's
				-- bottom-left corner is pinned to the canvas corner, so the
				-- rounded-up overhang falls off the top/right edge.
				Canvas = Background {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, Expression = "InputRouter.Output.Width", },
						Height = Input { Value = 1080, Expression = "InputRouter.Output.Height", },
						UseFrameFormatSettings = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 1210, 33 } },
				},
				Upscale = Merge {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Background = Input {
							SourceOp = "Canvas",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "FrameHold",
							Source = "Output",
						},
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(Downscale.Width * max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)) / (2 * InputRouter.Output.Width), Downscale.Height * max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5)) / (2 * InputRouter.Output.Height))",
						},
						Size = Input {
							Value = 6,
							Expression = "max(1, floor(Labels.PixelSize * min(InputRouter.Output.Width, InputRouter.Output.Height) / 1080 + 0.5))",
						},
						FilterMethod = Input { Value = 0, },
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 1210, 0 } },
