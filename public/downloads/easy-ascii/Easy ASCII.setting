{
	Tools = ordered() {
		EasyASCII = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "PipeRouter1",
					Source = "Input",
				},

				----------------------------------------------------------------
				-- Section headers are collapsible LabelControls on "Labels":
				-- each HideN_x hides the next N controls. Sections are ordered
				-- by how often they get tweaked; rarely used ones start closed
				-- (label Value = 0 in the Labels tool).
				----------------------------------------------------------------
				-- Header and credit buttons, same layout as Easy CRT.
				-- The Cadenzy and site buttons open The Editing Lair (bmd.openurl).
				HeaderLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "Header",
					Page = "Controls",
					Width = 1,
				},
				MadeByButton = InstanceInput {
					SourceOp = "Labels",
					Source = "MadeByButton",
					Page = "Controls",
					Width = 1,
				},
				SiteButton = InstanceInput {
					SourceOp = "Labels",
					Source = "SiteButton",
					Page = "Controls",
					Width = 1,
				},

				-- GRID: how many characters fit across the frame
				Dropdown5 = InstanceInput {
					SourceOp = "Labels",
					Source = "Hide1_1",
					Name = "Grid",
					Page = "Controls",
					Default = 1,
				},
				Input2 = InstanceInput {
					SourceOp = "MosaicBlur2_1",
					Source = "PixelFrequency",
					Name = "Density",
					MinScale = 0.2000000029802,
					MaxScale = 300,
					Default = 150,
				},

				-- CHARACTERS: which glyphs map to the brightness levels
				Dropdown3 = InstanceInput {
					SourceOp = "Labels",
					Source = "Hide2_2",
					Name = "Characters",
					Page = "Controls",
					Default = 1,
				},
				Input17 = InstanceInput {
					SourceOp = "Switch1",
					Source = "Source",
					Name = "Character Set",
					Default = 4,
				},
				Input18 = InstanceInput {
					SourceOp = "Switch1",
					Source = "Input0",
					Name = "Custom (9, light to dense)",
				},

				-- COLOR: gradient that tints the characters
				Dropdown2 = InstanceInput {
					SourceOp = "Labels",
					Source = "Hide2_1",
					Name = "Color",
					Page = "Controls",
					Default = 1,
				},
				Input270 = InstanceInput {
					SourceOp = "Switch1_1_1",
					Source = "Source",
					Name = "Palette",
					Default = 0,
				},
				Input280 = InstanceInput {
					SourceOp = "Switch1_1_1",
					Source = "Input0",
					Name = "Custom Gradient",
				},

				-- TONE: brightness levels fed into the character mapping
				Dropdown1 = InstanceInput {
					SourceOp = "Labels",
					Source = "Hide5_1",
					Name = "Tone",
					Page = "Controls",
					Default = 0,
				},
				Input6 = InstanceInput {
					SourceOp = "BrightnessContrast_1",
					Source = "Contrast",
					Name = "Contrast",
					MinScale = 0,
					MaxScale = 2,
					Default = 1,
				},
				Input4 = InstanceInput {
					SourceOp = "BrightnessContrast_1",
					Source = "Lift",
					Default = 0,
				},
				Input5 = InstanceInput {
					SourceOp = "BrightnessContrast_1",
					Source = "Gamma",
					Default = 1,
				},
				Input3 = InstanceInput {
					SourceOp = "BrightnessContrast_1",
					Source = "Gain",
					Default = 1,
				},
				Input7 = InstanceInput {
					SourceOp = "InvertColor1_1",
					Source = "Blend",
					Default = 1,
				},

				-- TYPOGRAPHY: font and glyph placement inside each cell
				Dropdown31 = InstanceInput {
					SourceOp = "Labels",
					Source = "Hide5_2",
					Name = "Typography",
					Page = "Controls",
					Default = 0,
				},
				Input9 = InstanceInput {
					SourceOp = "T8",
					Source = "Font",
					ControlGroup = 10,
				},
				Input10 = InstanceInput {
					SourceOp = "T8",
					Source = "Style",
					ControlGroup = 10,
				},
				Input11 = InstanceInput {
					SourceOp = "T8",
					Source = "Size",
					Default = 1.5,
				},
				Input150 = InstanceInput {
					SourceOp = "T8",
					Source = "WordSizeX",
					Name = "Width",
					Default = 1,
				},
				Input160 = InstanceInput {
					SourceOp = "T8",
					Source = "WordSizeY",
					Name = "Height",
					Default = 1,
				},

				-- COLOR CORRECTION: final grade on the ASCII result
				Dropdown4 = InstanceInput {
					SourceOp = "Labels",
					Source = "Hide7_1",
					Name = "Color Correction",
					Page = "Controls",
					Default = 0,
				},
				Input19 = InstanceInput {
					SourceOp = "ColorCorrector1_1",
					Source = "WheelHue1",
					ControlGroup = 19,
				},
				Input20 = InstanceInput {
					SourceOp = "ColorCorrector1_1",
					Source = "WheelSaturation1",
					ControlGroup = 19,
					Default = 1,
				},
				Input21 = InstanceInput {
					SourceOp = "ColorCorrector1_1",
					Source = "WheelTintAngle1",
					ControlGroup = 19,
				},
				Input22 = InstanceInput {
					SourceOp = "ColorCorrector1_1",
					Source = "WheelTintLength1",
					ControlGroup = 19,
				},
				Input23 = InstanceInput {
					SourceOp = "ColorCorrector1_1",
					Source = "WheelRangeDummy1",
					ControlGroup = 19,
					Default = 0,
				},
				Input24 = InstanceInput {
					SourceOp = "ColorCorrector1_1",
					Source = "Hue1",
					Name = "Hue",
				},
				Input25 = InstanceInput {
					SourceOp = "ColorCorrector1_1",
					Source = "Saturation1",
					Name = "Saturation",
					Default = 1,
				}
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "ColorCorrector1_1",
					Source = "Output",
				}
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
