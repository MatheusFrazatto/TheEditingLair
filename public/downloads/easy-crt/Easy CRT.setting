				},
				Merge_4 = Merge {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						EffectMask = Input { SourceOp = "Merge_1", Source = "Output", },
						MaskChannel = Input { Value = 1, },
						Background = Input { SourceOp = "Merge_3", Source = "Output", },
						Foreground = Input { SourceOp = "Solid_Green", Source = "Output", },
						Size = Input { Value = 0.4, Expression = "Solid_Black.MaskSize * Solid_Black.GreenWidth * min(Solid_Black.Output.Width, Solid_Black.Output.Height) / 1080", },
						Edges = Input { Value = 1, },
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 2915, 247.5 } },
				},
				Solid_Black = Background {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						MaskSize = Input { Value = 1, },
