{
	Tools = ordered() {
		EasyCRT = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "Stop_Motion",
					Source = "Source",
				},

				----------------------------------------------------------------
				-- Single page, sections ordered by how often they get tweaked.
				-- Section headers are collapsible LabelControls on Solid_Black:
				-- each hides the next LBLC_NumInputs controls, INP_Default
				-- 1 = open, 0 = collapsed.
				----------------------------------------------------------------
				ControlsPage = Input {
					Type = "Page",
					Page = "Controls",
				},
				Solid_Black_HeaderLabel = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "HeaderLabel",
					Page = "Controls",
					Width = 1,
				},
				-- Credit buttons: full-width rounded buttons under the header.
				-- The Cadenzy and site buttons open The Editing Lair (bmd.openurl).
				Solid_Black_MadeByButton = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "MadeByButton",
					Page = "Controls",
					Width = 1,
				},
				Solid_Black_SiteButton = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "SiteButton",
					Page = "Controls",
					Width = 1,
				},
				-- Blends the CRT look with the clean image before the screen
				-- geometry, so partial mixes never show a doubled frame.
				Dissolve_Mix = InstanceInput {
					SourceOp = "Dissolve",
					Source = "Mix",
					Name = "Mix",
					Page = "Controls",
					Default = 1,
				},

				-- SCREEN: tube shape and framing
				Solid_Black_ScreenLabel = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "ScreenLabel",
					Page = "Controls",
					Default = 1,
				},
				Lens_Distortion_distortionAmountR = InstanceInput {
					SourceOp = "Lens_Distortion",
					Source = "distortionAmountR",
					Name = "Curvature",
					Default = -0.4,
				},
				Transform_Size = InstanceInput {
					SourceOp = "Transform",
					Source = "Size",
					Name = "Overscan",
					Default = 1.25,
				},
				Prism_Blur_VignetteSize = InstanceInput {
					SourceOp = "Prism_Blur",
					Source = "VignetteSize",
					Name = "Vignette Size",
					Default = 0.25,
				},
				Prism_Blur_VignetteSharpness = InstanceInput {
					SourceOp = "Prism_Blur",
					Source = "VignetteSharpness",
					Name = "Vignette Sharpness",
					Default = 5,
				},

				-- PHOSPHOR MASK: RGB subpixel grid
				Solid_Black_MaskLabel = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "MaskLabel",
					Page = "Controls",
					Default = 1,
				},
				Brightness_Contrast_Gain = InstanceInput {
					SourceOp = "Brightness_Contrast",
					Source = "Gain",
					Name = "Brightness",
					Default = 1.75,
				},
				-- Merge_3/4/5 Size = MaskSize * <Color>Width * min(W, H) / 1080
				-- (expressions below), so a setting looks the same at any resolution.
				Solid_Black_MaskSize = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "MaskSize",
					Name = "Mask Size",
					Default = 1,
				},
				Solid_Black_RedWidth = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "RedWidth",
					Name = "Red Width",
					Default = 0.4,
				},
				Solid_Black_GreenWidth = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "GreenWidth",
					Name = "Green Width",
					Default = 0.4,
				},
				Solid_Black_BlueWidth = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "BlueWidth",
					Name = "Blue Width",
					Default = 0.4,
				},

				-- GLOW: inner glow + outer bloom
				Solid_Black_GlowLabel = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "GlowLabel",
					Page = "Controls",
					Default = 1,
				},
				-- Merge_1 Blend = GlowOn
				Solid_Black_GlowOn = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "GlowOn",
					Default = 1,
				},
				Luma_Keyer_MatteGamma = InstanceInput {
					SourceOp = "Luma_Keyer",
					Source = "MatteGamma",
					Name = "Threshold",
					Default = 0.5,
				},
				Soft_Glow_1_Gain = InstanceInput {
					SourceOp = "Soft_Glow_1",
					Source = "Gain",
					Name = "Glow Amount",
					Default = 0.25,
					MinScale = 0,
					MaxScale = 1,
				},
				Soft_Glow_1_XGlowSize = InstanceInput {
					SourceOp = "Soft_Glow_1",
					Source = "XGlowSize",
					Name = "Glow Size",
					Default = 15,
					MinScale = 0,
					MaxScale = 50,
				},
				Soft_Glow_2_Gain = InstanceInput {
					SourceOp = "Soft_Glow_2",
					Source = "Gain",
					Name = "Bloom Amount",
					Default = 1,
					MinScale = 0,
					MaxScale = 3,
				},
				Soft_Glow_2_XGlowSize = InstanceInput {
					SourceOp = "Soft_Glow_2",
					Source = "XGlowSize",
					Name = "Bloom Size",
					Default = 50,
				},

				-- HALATION & GRAIN
				Solid_Black_HalationLabel = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "HalationLabel",
					Page = "Controls",
					Default = 0,
				},
				-- Halation dyeReflStrength = HalationOn * 0.5
				Solid_Black_HalationOn = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "HalationOn",
					Default = 1,
				},
				Halation_isolationHDRMin = InstanceInput {
					SourceOp = "Halation",
					Source = "isolationHDRMin",
					Name = "Halation Threshold",
					Default = 1.5,
					MinScale = 0,
					MaxScale = 5,
				},
				Halation_grainIsEnabled = InstanceInput {
					SourceOp = "Halation",
					Source = "grainIsEnabled",
					Name = "Grain",
					Default = 1,
				},
				Halation_grainStrength = InstanceInput {
					SourceOp = "Halation",
					Source = "grainStrength",
					Name = "Grain Amount",
					Default = 1,
				},

				-- COLOR FRINGE: chromatic aberration
				Solid_Black_FringeLabel = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "FringeLabel",
					Page = "Controls",
					Default = 0,
				},
				-- Prism_Blur AberrationStrength = FringeOn * FringeStrength
				Solid_Black_FringeOn = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "FringeOn",
					Default = 1,
				},
				Solid_Black_FringeStrength = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "FringeStrength",
					Name = "Strength",
					Default = 0.4,
				},
				Prism_Blur_AberrationDistance = InstanceInput {
					SourceOp = "Prism_Blur",
					Source = "AberrationDistance",
					Name = "Distance",
					Default = 0.01,
					MinScale = 0,
					MaxScale = 0.05,
				},

				-- SIGNAL: frame cadence + refresh flicker
				Solid_Black_SignalLabel = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "SignalLabel",
					Page = "Controls",
					Default = 0,
				},
				Stop_Motion_frameRepeat = InstanceInput {
					SourceOp = "Stop_Motion",
					Source = "frameRepeat",
					Name = "Frame Repeat",
					Default = 2,
					MinScale = 1,
					MaxScale = 6,
				},
				-- Flicker_Addition flickerRange = FlickerOn * FlickerAmount
				Solid_Black_FlickerOn = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "FlickerOn",
					Default = 1,
				},
				Flicker_Addition_flickerType = InstanceInput {
					SourceOp = "Flicker_Addition",
					Source = "flickerType",
					Name = "Flicker Type",
				},
				Solid_Black_FlickerAmount = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "FlickerAmount",
					Name = "Flicker Amount",
					Default = 0.05,
				},
				Flicker_Addition_flickerSpeed = InstanceInput {
					SourceOp = "Flicker_Addition",
					Source = "flickerSpeed",
					Name = "Flicker Speed",
					Default = 3,
				},

				-- ADVANCED: set-and-forget technical controls
				Solid_Black_AdvancedLabel = InstanceInput {
					SourceOp = "Solid_Black",
					Source = "AdvancedLabel",
					Page = "Controls",
					Default = 0,
				},
				Lens_Distortion_xyPosition = InstanceInput {
					SourceOp = "Lens_Distortion",
					Source = "xyPosition",
					Name = "Curvature Center",
				},
				Flicker_Addition_randSeed = InstanceInput {
					SourceOp = "Flicker_Addition",
					Source = "randSeed",
					Name = "Flicker Variation",
					Default = 1,
				},
				Halation_ColorSpace = InstanceInput {
					SourceOp = "Halation",
					Source = "ColorSpace",
					Name = "Color Space",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Prism_Blur",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Rectangle_Mask_3 = RectangleMask {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						EffectMask = Input { SourceOp = "Rectangle_Mask_2", Source = "Mask", },
