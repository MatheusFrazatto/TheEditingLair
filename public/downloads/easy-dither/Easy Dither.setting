{
	Tools = ordered() {
		EasyDither = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				MainInput1 = InstanceInput {
					SourceOp = "PipeRouter1",
					Source = "Input",
				},

				----------------------------------------------------------------
				-- Pipeline: pixelate -> Overlay a
				-- Bayer pattern -> levels -> posterize -> restore colours.
				-- Section headers are collapsible LabelControls on "Labels":
				-- each hides the next LBLC_NumInputs controls.
				----------------------------------------------------------------
				ControlsPage = Input {
					Type = "Page",
					Page = "Controls",
				},
				Labels_Header = InstanceInput {
					SourceOp = "Labels",
					Source = "Header",
					Page = "Controls",
					Width = 1,
				},
				-- The Cadenzy and site buttons open The Editing Lair (bmd.openurl).
				Labels_MadeByButton = InstanceInput {
					SourceOp = "Labels",
					Source = "MadeByButton",
					Page = "Controls",
					Width = 1,
				},
				Labels_SiteButton = InstanceInput {
					SourceOp = "Labels",
					Source = "SiteButton",
					Page = "Controls",
					Width = 1,
				},
				Mix_Mix = InstanceInput {
					SourceOp = "Mix",
					Source = "Mix",
					Name = "Mix",
					Page = "Controls",
					Default = 1,
				},

				-- DITHER: cell size, pattern and how strongly it is overlaid
				Labels_DitherLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "DitherLabel",
					Page = "Controls",
					Default = 1,
				},
				Input2 = InstanceInput {
					SourceOp = "PIXL_1",
					Source = "DitherSize",
					MaxScale = 20,
					Default = 5,
				},
				Pattern_NumberIn1 = InstanceInput {
					SourceOp = "Pattern",
					Source = "NumberIn1",
					Name = "Pattern",
					Default = 0,
				},
				Switch2_Source = InstanceInput {
					SourceOp = "Switch2",
					Source = "Source",
					Name = "Direction",
					Default = 0,
				},
				Input3 = InstanceInput {
					SourceOp = "DITHER_STRENGTH",
					Source = "BlendClone",
					Name = "Dither Strength",
					Default = 1,
				},

				-- COLOR: number of levels and whether the source colours return
				Labels_ColorLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "ColorLabel",
					Page = "Controls",
					Default = 1,
				},
				Input31 = InstanceInput {
					SourceOp = "POSTERIZE",
					Source = "NumberIn1",
					Name = "Posterize Steps",
					MaxScale = 10,
					Page = "Controls",
					Default = 3,
				},
				Labels_ColorMode = InstanceInput {
					SourceOp = "Labels",
					Source = "ColorMode",
					Default = 0,
				},

				-- DUOTONE: two-colour remap of the dithered luminance
				Labels_DuotoneLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "DuotoneLabel",
					Page = "Controls",
					Default = 0,
				},
				Input191 = InstanceInput {
					SourceOp = "DUO_TONING_1",
					Source = "Blend",
					Default = 0,
				},
				-- Preset picks the pair; the colour pickers apply in "Custom".
				-- DUO_TONING_1 Gain/Lift are driven by expressions from these.
				Labels_DuoPreset = InstanceInput {
					SourceOp = "Labels",
					Source = "DuoPreset",
					Default = 0,
				},
				Labels_HighlightRed = InstanceInput {
					SourceOp = "Labels",
					Source = "HighlightRed",
					Name = "Highlight",
					ControlGroup = 13,
					Default = 1,
				},
				Labels_HighlightGreen = InstanceInput {
					SourceOp = "Labels",
					Source = "HighlightGreen",
					Name = "Highlight",
					ControlGroup = 13,
					Default = 1,
				},
				Labels_HighlightBlue = InstanceInput {
					SourceOp = "Labels",
					Source = "HighlightBlue",
					Name = "Highlight",
					ControlGroup = 13,
					Default = 1,
				},
				Labels_ShadowRed = InstanceInput {
					SourceOp = "Labels",
					Source = "ShadowRed",
					Name = "Shadow",
					ControlGroup = 14,
					Default = 0,
				},
				Labels_ShadowGreen = InstanceInput {
					SourceOp = "Labels",
					Source = "ShadowGreen",
					Name = "Shadow",
					ControlGroup = 14,
					Default = 0,
				},
				Labels_ShadowBlue = InstanceInput {
					SourceOp = "Labels",
					Source = "ShadowBlue",
					Name = "Shadow",
					ControlGroup = 14,
					Default = 0,
				},

				-- TONE: levels applied before posterizing
				Labels_ToneLabel = InstanceInput {
					SourceOp = "Labels",
					Source = "ToneLabel",
					Page = "Controls",
					Default = 0,
				},
				Input35 = InstanceInput {
					SourceOp = "ADJUST_LEVELS",
					Source = "Contrast",
					Default = 0,
				},
				Input36 = InstanceInput {
					SourceOp = "ADJUST_LEVELS",
					Source = "Brightness",
					Default = 0,
				},
				Input33 = InstanceInput {
					SourceOp = "ADJUST_LEVELS",
					Source = "Lift",
					Default = 0,
				},
				Input34 = InstanceInput {
					SourceOp = "ADJUST_LEVELS",
					Source = "Gamma",
					Default = 1,
				},
				Input32 = InstanceInput {
					SourceOp = "ADJUST_LEVELS",
					Source = "Gain",
					Default = 1,
				},
				Input37 = InstanceInput {
					SourceOp = "ADJUST_LEVELS",
					Source = "Low",
					ControlGroup = 30,
					Default = 0,
				},
				Input38 = InstanceInput {
					SourceOp = "ADJUST_LEVELS",
					Source = "High",
					ControlGroup = 30,
					Default = 1,
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "Mix",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Labels = Merge {
					PassThrough = true,
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						PerformDepthMerge = Input { Value = 0, },
						DitherLabel = Input { Value = 1, },
						ColorLabel = Input { Value = 1, },
						DuotoneLabel = Input { Value = 0, },
						ToneLabel = Input { Value = 0, },
						ColorMode = Input { Value = 0, },
						DuoPreset = Input { Value = 0, },
						HighlightRed = Input { Value = 1, },
						HighlightGreen = Input { Value = 1, },
						HighlightBlue = Input { Value = 1, },
						ShadowRed = Input { Value = 0, },
						ShadowGreen = Input { Value = 0, },
						ShadowBlue = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 110, 41.7573 } },
					UserControls = ordered() {
						-- Title as a full-width button: Fusion always centres button
						-- text, while a LabelControl stays left-aligned. No action.
						Header = {
							LINKS_Name = "Easy Dither  |  v1.1.0",
							LINKID_DataType = "Number",
							INPID_InputControl = "ButtonControl",
							INP_Integer = true,
							ICD_Width = 1,
							INP_External = false,
							ICS_ControlPage = "Controls",
						},
						MadeByButton = {
							LINKS_Name = "Made by Cadenzy", BTNCS_Execute = "bmd.openurl(\"https://matheusfrazatto.github.io/TheEditingLair/about/\")",
							LINKID_DataType = "Number",
							INPID_InputControl = "ButtonControl",
							INP_Integer = true,
							ICD_Width = 1,
							INP_External = false,
							ICS_ControlPage = "Controls",
						},
						SiteButton = {
							LINKS_Name = "The Editing Lair", BTNCS_Execute = "bmd.openurl(\"https://matheusfrazatto.github.io/TheEditingLair/\")",
							LINKID_DataType = "Number",
							INPID_InputControl = "ButtonControl",
							INP_Integer = true,
							ICD_Width = 1,
							INP_External = false,
							ICS_ControlPage = "Controls",
						},
						-- Collapsible sections; grouped colours count as 3 inputs
						DitherLabel = {
							LINKS_Name = "Dither",
							LINKID_DataType = "Number",
							INPID_InputControl = "LabelControl",
							LBLC_DropDownButton = true,
							LBLC_NumInputs = 4,
							LBLC_NestLevel = 1,
							INP_Default = 1,
							INP_External = false,
							INP_Passive = true,
							ICS_ControlPage = "Controls",
						},
						ColorLabel = {
							LINKS_Name = "Color",
							LINKID_DataType = "Number",
							INPID_InputControl = "LabelControl",
							LBLC_DropDownButton = true,
							LBLC_NumInputs = 2,
							LBLC_NestLevel = 1,
							INP_Default = 1,
							INP_External = false,
							INP_Passive = true,
							ICS_ControlPage = "Controls",
						},
						DuotoneLabel = {
							LINKS_Name = "Duotone",
							LINKID_DataType = "Number",
							INPID_InputControl = "LabelControl",
							LBLC_DropDownButton = true,
							LBLC_NumInputs = 8,
							LBLC_NestLevel = 1,
							INP_Default = 0,
							INP_External = false,
							INP_Passive = true,
							ICS_ControlPage = "Controls",
						},
						ToneLabel = {
							LINKS_Name = "Tone",
							LINKID_DataType = "Number",
							INPID_InputControl = "LabelControl",
							LBLC_DropDownButton = true,
							LBLC_NumInputs = 7,
							LBLC_NestLevel = 1,
							INP_Default = 0,
							INP_External = false,
							INP_Passive = true,
							ICS_ControlPage = "Controls",
						},
						-- Original: hue/sat from the dithered source.
						-- Posterized: hue/sat from the posterized, un-dithered source,
						-- so near-greys collapse to grey instead of splitting into
						-- RGB speckles.
						ColorMode = {
							LINKS_Name = "Color Mode",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							INP_Integer = true,
							INP_Default = 0,
							{ CCS_AddString = "Original", },
							{ CCS_AddString = "Posterized", },
							CC_LabelPosition = "Horizontal",
							ICS_ControlPage = "Controls",
						},
						DuoPreset = {
							LINKS_Name = "Preset",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							INP_Integer = true,
							INP_Default = 0,
							{ CCS_AddString = "Custom", },
							{ CCS_AddString = "Cyan Night", },
							{ CCS_AddString = "Hot Pink", },
							{ CCS_AddString = "Indigo & Coral", },
							{ CCS_AddString = "Magenta & Sky", },
							{ CCS_AddString = "Navy & Blush", },
							{ CCS_AddString = "Navy & Lilac", },
							{ CCS_AddString = "Plum & Mint", },
							{ CCS_AddString = "Plum & Pink", },
							{ CCS_AddString = "Red & Cream", },
							{ CCS_AddString = "Teal & Mint", },
							{ CCS_AddString = "Violet & Mint", },
							{ CCS_AddString = "Wine & Peach", },
							CC_LabelPosition = "Horizontal",
							ICS_ControlPage = "Controls",
						},
						HighlightRed = {
							LINKS_Name = "Highlight Red",
							LINKID_DataType = "Number",
							INPID_InputControl = "ColorControl",
							IC_ControlGroup = 1,
							IC_ControlID = 0,
							CLRC_ShowWheel = false,
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						HighlightGreen = {
							LINKS_Name = "Highlight Green",
							LINKID_DataType = "Number",
							INPID_InputControl = "ColorControl",
							IC_ControlGroup = 1,
							IC_ControlID = 1,
							CLRC_ShowWheel = false,
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						HighlightBlue = {
							LINKS_Name = "Highlight Blue",
							LINKID_DataType = "Number",
							INPID_InputControl = "ColorControl",
							IC_ControlGroup = 1,
							IC_ControlID = 2,
							CLRC_ShowWheel = false,
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						ShadowRed = {
							LINKS_Name = "Shadow Red",
							LINKID_DataType = "Number",
							INPID_InputControl = "ColorControl",
							IC_ControlGroup = 2,
							IC_ControlID = 0,
							CLRC_ShowWheel = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						ShadowGreen = {
							LINKS_Name = "Shadow Green",
							LINKID_DataType = "Number",
							INPID_InputControl = "ColorControl",
							IC_ControlGroup = 2,
							IC_ControlID = 1,
							CLRC_ShowWheel = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
						ShadowBlue = {
							LINKS_Name = "Shadow Blue",
							LINKID_DataType = "Number",
							INPID_InputControl = "ColorControl",
							IC_ControlGroup = 2,
							IC_ControlID = 2,
							CLRC_ShowWheel = false,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							ICS_ControlPage = "Controls",
						},
					},
				},
				-- Pattern tile generated procedurally (replaces the Dither1.png
				-- loader, so the macro is a single file). 8x8 px holds every
				-- pattern period. Values span 0..1 for the Overlay merge:
				--   0-2 Bayer 2x2/4x4/8x8: rank / (N^2 - 1), rank from the pixel
				--       index bits; the 2x2 rank-2 cell is 157/255 to match the
				--       original PNG (0, 85, 157, 255)
				--   3 Lines: row mod 4;  4 Diagonal: (col + row) mod 4
				--   5 Dots: squared distance from the centre of a 4x4 cell
				PatternBase = Background {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 8, },
						Height = Input { Value = 8, },
						UseFrameFormatSettings = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { -110, 41.7573 } },
				},
				Pattern = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						NumberIn1 = Input { Value = 0, },
						Setup1 = Input { Value = "min(1, max(0, n1))", },
						Setup2 = Input { Value = "min(1, max(0, n1 - 1))", },
						Setup3 = Input { Value = "4*(1 + 3*min(1, max(0, n1)))*(1 + 3*min(1, max(0, n1 - 1)))", },
						Intermediate1 = Input { Value = "min(1, max(0, 3 - n1))*(((2*abs((floor(x*w)-2*floor(x*w/2))-(floor(y*h)-2*floor(y*h/2)))+(floor(y*h)-2*floor(y*h/2)))/4 + s1*(2*abs((floor(x*w/2)-2*floor(x*w/4))-(floor(y*h/2)-2*floor(y*h/4)))+(floor(y*h/2)-2*floor(y*h/4)))/16 + s2*(2*abs((floor(x*w/4)-2*floor(x*w/8))-(floor(y*h/4)-2*floor(y*h/8)))+(floor(y*h/4)-2*floor(y*h/8)))/64)*s3/(s3 - 1) + (1 - min(1, abs(n1)))*(floor(x*w)-2*floor(x*w/2))*(1 - (floor(y*h)-2*floor(y*h/2)))*(157/255 - 2/3)) + (1 - min(1, abs(n1 - 3)))*(floor(y*h) - 4*floor(y*h/4))/3 + (1 - min(1, abs(n1 - 4)))*((floor(x*w) + floor(y*h)) - 4*floor((floor(x*w) + floor(y*h))/4))/3 + (1 - min(1, abs(n1 - 5)))*(((floor(x*w) - 4*floor(x*w/4)) - 1.5)*((floor(x*w) - 4*floor(x*w/4)) - 1.5) + ((floor(y*h) - 4*floor(y*h/4)) - 1.5)*((floor(y*h) - 4*floor(y*h/4)) - 1.5) - 0.5)/4", },
						RedExpression = Input { Value = "i1", },
						GreenExpression = Input { Value = "i1", },
						BlueExpression = Input { Value = "i1", },
						AlphaExpression = Input { Value = "1", },
						Image1 = Input {
							SourceOp = "PatternBase",
							Source = "Output",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 0, 41.7573 } },
					UserControls = ordered() {
						NumberIn1 = {
							LINKS_Name = "Pattern",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							INP_Integer = true,
							INP_Default = 0,
							{ CCS_AddString = "Bayer 2x2", },
							{ CCS_AddString = "Bayer 4x4", },
							{ CCS_AddString = "Bayer 8x8", },
							{ CCS_AddString = "Lines", },
							{ CCS_AddString = "Diagonal", },
							{ CCS_AddString = "Dots", },
							CC_LabelPosition = "Horizontal",
							ICS_ControlPage = "Controls",
						},
					},
				},
				PipeRouter1 = PipeRouter {
					CtrlWShown = false,
					ViewInfo = PipeRouterInfo { Pos = { -440, 148.5 } },
				},
				PIXL_1 = Transform {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Pivot = Input { Value = { 0, 0 }, },
						Size = Input {
							Value = 0.2,
							Expression = "1/max(1, floor(DitherSize * min(PipeRouter1.Output.Width, PipeRouter1.Output.Height) / 1080 + 0.5))",
						},
						Edges = Input { Value = 3, },
						FilterMethod = Input { Value = 0, },
						FlattenTransform = Input { Value = 1, },
						Input = Input {
							SourceOp = "PipeRouter1",
							Source = "Output",
						},
						DitherSize = Input { Value = 5, }
					},
					ViewInfo = OperatorInfo { Pos = { -330, 148.5 } },
					UserControls = ordered() {
						DitherSize = {
							INP_Default = 1,
							INP_Integer = true,
							INP_SplineType = "Default",
							INPID_InputControl = "SliderControl",
							INP_MinScale = 1,
							LINKID_DataType = "Number",
							INP_MaxScale = 20,
							LINKS_Name = "Dither Size",
						}
					}
				},
				DITHER_STRENGTH = Merge {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						ProcessAlpha = Input { Value = 0, },
						Background = Input {
							SourceOp = "CLIP_DOMAIN",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "OFFSET_DITHER",
							Source = "Output",
						},
						Center = Input { Value = { 0, 0 }, },
						Size = Input {
							Value = 5,
							Expression = "1/PIXL_1.Size",
						},
						Angle = Input {
							SourceOp = "Switch2",
							Source = "Output",
						},
						ApplyMode = Input { Value = FuID { "Overlay" }, },
						Edges = Input { Value = 1, },
						FilterMethod = Input { Value = 0, },
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 0, 148.5 } },
				},
				SECOND_CLIP_DOMAIN = SetDomain {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Mode = Input { Value = FuID { "Set" }, },
						Input = Input {
							SourceOp = "DITHER_STRENGTH",
							Source = "Output",
						}
					},
					ViewInfo = OperatorInfo { Pos = { 110, 148.5 } },
				},
				CLIP_DOMAIN = SetDomain {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Mode = Input { Value = FuID { "Set" }, },
						Input = Input {
							SourceOp = "PXL_2",
							Source = "Output",
						}
					},
					ViewInfo = OperatorInfo { Pos = { -110, 148.5 } },
				},
				PXL_2 = Transform {
					CtrlWShown = false,
					NameSet = true,
					SourceOp = "PIXL_1",
					Inputs = {
						EffectMask = Input {
						},
						SettingsNest = Input {
						},
						LayersNest = Input {
						},
						TransformNest = Input {
						},
						Size = Input {
							Value = 0.2,
							Expression = "PIXL_1.Size"
						},
						FilterMethod = Input {
							Value = 0,
						},
						InvertTransform = Input {
							Value = 1,
						},
						ReferenceSize = Input {
						},
						Input = Input {
							SourceOp = "PIXL_1",
							Source = "Output",
						},
						CommentsNest = Input {
						},
						FrameRenderScriptNest = Input {
						},
						StartRenderScripts = Input {
						},
						EndRenderScripts = Input {
						}
					},
					ViewInfo = OperatorInfo { Pos = { -220, 148.5 } },
				},
				Switch2 = SwitchNumber {
					CtrlWZoom = false,
					Inputs = {
						Name0 = Input { Value = "Vertical", },
						Name1 = Input { Value = "Horizontal", },
						Input1 = Input { Value = 90, }
					},
					Colors = { TileColor = { R = 0.572549019607843, G = 0.572549019607843, B = 0.572549019607843 }, }
				},
				OFFSET_DITHER = Transform {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Center = Input { Value = { 1, 1 }, },
						Edges = Input { Value = 1, },
						Input = Input {
							SourceOp = "Pattern",
							Source = "Output",
						}
					},
					ViewInfo = OperatorInfo { Pos = { 0, 107.758 } },
				},
				ORIGINAL_COLORS = Merge {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Quality = Input { Value = 5, },
						ShutterAngle = Input { Value = 240, },
						Background = Input {
							SourceOp = "POSTERIZE",
							Source = "Output",
						},
						Foreground = Input {
							SourceOp = "SECOND_CLIP_DOMAIN",
							Source = "Output",
						},
						ApplyMode = Input { Value = FuID { "Color" }, },
						Blend = Input { Value = 1, Expression = "iif(Labels.ColorMode == 0, 1, 0)", },
						PerformDepthMerge = Input { Value = 0, }
					},
					ViewInfo = OperatorInfo { Pos = { 330, 148.5 } },
				},
				-- Posterized colour mode: hue/saturation source for PALETTE_COLORS,
				-- taken from the pixelated source WITHOUT the dither overlay.
				-- Only the chroma (channel minus luma) is quantized, in steps of
				-- s1 = 0.3 / Posterize Steps, then added back to the luma:
				--   c' = L + round((c - L) / s1) * s1
				-- Posterizing whole RGB channels instead pushed low channels to 0
				-- and turned dark tinted greys into fully saturated blue/teal;
				-- this way saturation never grows, near-greys collapse to grey,
				-- and strong colours keep a reduced palette.
				PALETTE_POSTERIZE = Custom {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						NumberIn1 = Input { Value = 3, Expression = "POSTERIZE.NumberIn1", },
						Setup1 = Input { Value = "0.3 / max(1, n1)", },
						Intermediate1 = Input { Value = "0.299*r1 + 0.587*g1 + 0.114*b1", },
						RedExpression = Input { Value = "i1 + floor((r1 - i1) / s1 + 0.5) * s1", },
						GreenExpression = Input { Value = "i1 + floor((g1 - i1) / s1 + 0.5) * s1", },
